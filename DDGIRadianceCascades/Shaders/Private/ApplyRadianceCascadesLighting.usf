/*
 * Deferred diffuse-lighting application for the single sparse Radiance Cascades GI backend.
 * The cascade lattice owns probe storage, tracing, integration and interpolation.
 */
#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadeLayout.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadePacking.ush"

Texture2D<float4> NormalTexture;
Texture2D<float> DepthTexture;
Texture2D<float4> BaseColorTexture;
Texture2D<float4> MetallicTexture;
Texture2D<float> ScreenSpaceAOTexture;
uint bHasScreenSpaceAO;
Texture2D<float4> DirectionsTexture;
Texture2D<uint> RadianceTexture;
Texture2D<uint> HitTriangleIndexTexture;
Texture2D<float4> VisibilityMomentsTexture;
Texture2D<float4> ProbePositionsTexture;
StructuredBuffer<int4> ProbeSpatialHash;
StructuredBuffer<uint> ProbeNeighborIndices;
StructuredBuffer<uint> LogicalToPhysicalSlots;
uint UsePrecomputedProbeNeighbors;
Texture2D<float4> SceneColorTexture;
RWTexture2D<float4> SceneColorOutputUAV;
SamplerState PointClampSampler;

float4 ScaledViewSizeAndInvSize;
float2 ViewRectMin;
uint ProbeCount;
uint TotalRaysPerProbe;
uint BaseRayCount;
uint HashCapacity;
float ProbeSpacing;
float BaseSegmentLength;
float CascadeScale;
float MaxTraceDistance;
uint CascadeCount;
float ProbeGridDistance;
float4 ProbeGridOrigin;
float4 ActiveWindowCenterCell;
float4 ActiveWindowCenterLocal;
float4 BVHWorldOrigin;
uint ShouldUsePreExposure;
uint DebugMode;

#define DDGI_RC_TEXTURE_WIDTH 4096u

uint DDGIHashProbeCell(int3 Cell, uint Level)
{
    uint Hash = asuint(Cell.x) * 0x8DA6B343u;
    Hash ^= asuint(Cell.y) * 0xD8163841u;
    Hash ^= asuint(Cell.z) * 0xCB1AB31Fu;
    Hash ^= (Level + 1u) * 0x9E3779B9u;
    Hash ^= Hash >> 16;
    Hash *= 0x7FEB352Du;
    Hash ^= Hash >> 15;
    Hash *= 0x846CA68Bu;
    Hash ^= Hash >> 16;
    return Hash;
}

bool DDGIFindProbeInCell(int3 Cell, uint Level, out uint OutProbeIndex)
{
    OutProbeIndex = 0u;
    if (HashCapacity == 0u || ProbeCount == 0u || Level > 7u) return false;
    uint Slot = DDGIHashProbeCell(Cell, Level) & (HashCapacity - 1u);
    // ProbeCount is not a safe probe bound: a collision cluster can be longer
    // than the number of entries. Search at most one complete hash-table cycle.
    [loop]
    for (uint Attempt = 0u; Attempt < HashCapacity; ++Attempt)
    {
        int4 Entry = ProbeSpatialHash[Slot];
        if (Entry.w < 0) return false;
        if (all(Entry.xyz == Cell) &&
            (((uint)Entry.w & 7u) == Level))
        {
            OutProbeIndex = (uint)Entry.w >> 3u;
            return OutProbeIndex < ProbeCount;
        }
        Slot = (Slot + 1u) & (HashCapacity - 1u);
    }
    return false;
}

bool DDGIIsProbeInitialized(uint ProbeIndex)
{
    uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];
    uint LinearIndex = PhysicalProbeIndex * TotalRaysPerProbe;
    uint2 Pixel = uint2(
        LinearIndex % DDGI_RC_TEXTURE_WIDTH,
        LinearIndex / DDGI_RC_TEXTURE_WIDTH);
    // Initialization writes this sentinel. The trace pass overwrites it for
    // every ray, including misses, so a black-but-untraced probe is distinct
    // from a legitimately dark, fully traced probe.
    return HitTriangleIndexTexture.Load(int3(Pixel, 0)) != 0xFFFFFFFFu;
}

// Estimate the fraction of child rays that remain unblocked at the receiver.
// The histogram includes misses as a separate open-space bin, so mixed near/far
// hit distributions cannot be hidden by a mean that lies behind the receiver.
float DDGIGetVisibilityHistogramBin(float4 Histogram0, float4 Histogram1, uint BinIndex)
{
    // Use explicit components instead of dynamic vector indexing. FXC's
    // literal-loop unroller can evaluate both sides of the old ternary and
    // diagnose Histogram1[BinIndex - 4] as an out-of-bounds access for bins 0-3.
    if (BinIndex == 0u) return Histogram0.x;
    if (BinIndex == 1u) return Histogram0.y;
    if (BinIndex == 2u) return Histogram0.z;
    if (BinIndex == 3u) return Histogram0.w;
    if (BinIndex == 4u) return Histogram1.x;
    if (BinIndex == 5u) return Histogram1.y;
    if (BinIndex == 6u) return Histogram1.z;
    return 0.0f;
}

float DDGIProbeVisibility(
    float4 Histogram0,
    float4 Histogram1,
    float ReceiverDistance)
{
    if (!all(isfinite(Histogram0)) || !all(isfinite(Histogram1)) ||
        any(Histogram0 < 0.0f) || any(Histogram1 < 0.0f))
    {
        return 0.0f;
    }

    const uint SampleCount = 1u << min(CascadeCount - 1u, 7u);
    const float TotalSamples =
        dot(Histogram0, float4(1.0f, 1.0f, 1.0f, 1.0f)) +
        dot(Histogram1, float4(1.0f, 1.0f, 1.0f, 1.0f));
    if (SampleCount < 2u ||
        abs(TotalSamples - (float)SampleCount) > 0.25f)
    {
        return 0.0f;
    }

    const float SafeMaxTraceDistance = max(MaxTraceDistance, 1.0f);
    // Beyond the traced range there is no evidence either way. Do not invent
    // occlusion from a histogram that never observed the receiver distance.
    if (!isfinite(ReceiverDistance) || ReceiverDistance > SafeMaxTraceDistance)
    {
        return 1.0f;
    }

    const float ReceiverBias = max(ProbeSpacing * 0.05f, 0.5f);
    const float BiasedReceiverDistance =
        max(ReceiverDistance - ReceiverBias, 0.0f);
    const float LogDistanceRange =
        max(log2(1.0f + SafeMaxTraceDistance), 1.0e-6f);
    const float BinCoordinate = saturate(
        log2(1.0f + BiasedReceiverDistance) / LogDistanceRange) * 7.0f;
    const uint FullBinCount = min((uint)floor(BinCoordinate), 6u);
    const float PartialBinFraction =
        saturate(BinCoordinate - (float)FullBinCount);

    float BlockedHitCount = 0.0f;
    [unroll]
    for (uint BinIndex = 0u; BinIndex < 7u; ++BinIndex)
    {
        const float BinCount =
            DDGIGetVisibilityHistogramBin(Histogram0, Histogram1, BinIndex);
        if (BinIndex < FullBinCount)
        {
            BlockedHitCount += BinCount;
        }
        else if (BinIndex == FullBinCount)
        {
            // Linear interpolation within the current logarithmic bin keeps
            // visibility continuous as the receiver crosses bin boundaries.
            BlockedHitCount += BinCount * PartialBinFraction;
        }
    }

    return saturate(
        ((float)SampleCount - BlockedHitCount) / (float)SampleCount);
}

float3 DDGIProbeDiffuseIrradiance(
    uint ProbeIndex,
    float3 ProbePosition,
    float3 LocalPosition,
    float3 Normal)
{
    float3 Irradiance = 0.0f;
    const uint SafeRayCount = min(BaseRayCount, min(TotalRaysPerProbe, 64u));
    if (SafeRayCount == 0u) return Irradiance;

    const uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];
    const float3 ToReceiver = LocalPosition - ProbePosition;
    const float ReceiverDistance = length(ToReceiver);
    const bool bCanEvaluateVisibility =
        isfinite(ReceiverDistance) && ReceiverDistance > 1.0e-3f;
    const float3 ReceiverDirection = bCanEvaluateVisibility
        ? ToReceiver / ReceiverDistance
        : float3(0.0f, 0.0f, 1.0f);
    float BestAngularAlignment = -2.0f;
    float SecondAngularAlignment = -2.0f;
    uint VisibilityBaseRayIndex = 0u;
    uint SecondVisibilityBaseRayIndex = 0u;

    // Integrate the base angular directions. Higher cascades refine the
    // radiance captured along those directions; they are not extra quadrature
    // samples for final diffuse irradiance.
    [loop]
    for (uint RayIndex = 0u; RayIndex < SafeRayCount; ++RayIndex)
    {
        const uint2 DirectionPixel = uint2(
            RayIndex % DDGI_RC_TEXTURE_WIDTH,
            RayIndex / DDGI_RC_TEXTURE_WIDTH);
        const float3 Direction = normalize(
            DirectionsTexture.Load(int3(DirectionPixel, 0)).xyz);

        if (bCanEvaluateVisibility)
        {
            const float AngularAlignment = dot(Direction, ReceiverDirection);
            if (AngularAlignment > BestAngularAlignment)
            {
                SecondAngularAlignment = BestAngularAlignment;
                SecondVisibilityBaseRayIndex = VisibilityBaseRayIndex;
                BestAngularAlignment = AngularAlignment;
                VisibilityBaseRayIndex = RayIndex;
            }
            else if (AngularAlignment > SecondAngularAlignment)
            {
                SecondAngularAlignment = AngularAlignment;
                SecondVisibilityBaseRayIndex = RayIndex;
            }
        }

        // DirectionsTexture stores probe-to-scene ray directions. At the
        // receiver, the direction toward the contributing probe is inverse.
        const float Cosine = saturate(dot(Normal, -Direction));
        if (Cosine > 0.0f)
        {
            const uint LinearIndex = PhysicalProbeIndex * TotalRaysPerProbe + RayIndex;
            const uint2 RadiancePixel = uint2(
                LinearIndex % DDGI_RC_TEXTURE_WIDTH,
                LinearIndex / DDGI_RC_TEXTURE_WIDTH);
            Irradiance += DDGIUnpackR11G11B10(
                RadianceTexture.Load(int3(RadiancePixel, 0))) * Cosine;
        }
    }

    // Evaluate visibility only from angular cells facing this receiver.
    // Histogram distances are measured along each probe ray, so compare them
    // with the receiver's projection onto that ray, not its radial distance.
    float Visibility = 1.0f;
    if (bCanEvaluateVisibility && CascadeCount >= 2u &&
        BestAngularAlignment > 1.0e-3f)
    {
        const uint BestLinearIndex =
            PhysicalProbeIndex * TotalRaysPerProbe + VisibilityBaseRayIndex;
        const uint2 BestPixel = uint2(
            BestLinearIndex % DDGI_RC_TEXTURE_WIDTH,
            BestLinearIndex / DDGI_RC_TEXTURE_WIDTH);
        const uint BestHistogramLinearIndex = BestLinearIndex + BaseRayCount;
        const uint2 BestHistogramPixel = uint2(
            BestHistogramLinearIndex % DDGI_RC_TEXTURE_WIDTH,
            BestHistogramLinearIndex / DDGI_RC_TEXTURE_WIDTH);
        const float4 BestHistogram0 =
            VisibilityMomentsTexture.Load(int3(BestPixel, 0));
        const float4 BestHistogram1 =
            VisibilityMomentsTexture.Load(int3(BestHistogramPixel, 0));
        const float BestProjectedDistance =
            ReceiverDistance * BestAngularAlignment;
        const float BestVisibility = DDGIProbeVisibility(
            BestHistogram0, BestHistogram1, BestProjectedDistance);

        const float AlignmentGap =
            max(BestAngularAlignment - SecondAngularAlignment, 0.0f);
        if (SafeRayCount > 1u && SecondAngularAlignment > 1.0e-3f &&
            AlignmentGap < 0.25f)
        {
            // The adjacent angular cell has its own ray direction and must
            // use its own projected receiver distance as well.
            const uint SecondLinearIndex =
                PhysicalProbeIndex * TotalRaysPerProbe + SecondVisibilityBaseRayIndex;
            const uint2 SecondPixel = uint2(
                SecondLinearIndex % DDGI_RC_TEXTURE_WIDTH,
                SecondLinearIndex / DDGI_RC_TEXTURE_WIDTH);
            const uint SecondHistogramLinearIndex = SecondLinearIndex + BaseRayCount;
            const uint2 SecondHistogramPixel = uint2(
                SecondHistogramLinearIndex % DDGI_RC_TEXTURE_WIDTH,
                SecondHistogramLinearIndex / DDGI_RC_TEXTURE_WIDTH);
            const float4 SecondHistogram0 =
                VisibilityMomentsTexture.Load(int3(SecondPixel, 0));
            const float4 SecondHistogram1 =
                VisibilityMomentsTexture.Load(int3(SecondHistogramPixel, 0));
            const float SecondProjectedDistance =
                ReceiverDistance * SecondAngularAlignment;
            const float SecondVisibility = DDGIProbeVisibility(
                SecondHistogram0, SecondHistogram1, SecondProjectedDistance);
            const float BestWeight =
                0.5f + 0.5f * smoothstep(0.0f, 0.25f, AlignmentGap);
            Visibility = lerp(SecondVisibility, BestVisibility, BestWeight);
        }
        else
        {
            Visibility = BestVisibility;
        }
    }

    // Equal-solid-angle quadrature gives 4*PI/N; Lambertian 1/PI
    // normalization leaves 4/N for the diffuse irradiance.
    return Irradiance * (4.0f / (float)SafeRayCount) * Visibility;
}
uint DDGIGetSpatialLevelStep(uint Level)
{
    // Keep in sync with DDGIGetSpatialLevelStep in DDGIRadianceCascadeResources.cpp
    // and the deterministic clipmap builder in DDGIMasterSubsystem.cpp.
    return 1u << min(Level, 3u);
}

int DDGIRoundCellToLevelStep(int Cell, uint LevelStep)
{
    // Match std::round in DDGISafeRoundCell: halfway values round away from zero.
    int Step = (int)LevelStep;
    int Quotient = Cell / Step;
    int Remainder = Cell % Step;
    if (abs(Remainder) * 2 >= Step)
    {
        Quotient += Cell < 0 ? -1 : 1;
    }
    return Quotient * Step;
}

float3 DDGISampleProbeLevel(
    float3 LocalPosition,
    float3 Normal,
    uint Level,
    out float OutSpatialWeightSum)
{
    OutSpatialWeightSum = 0.0f;
    float3 Irradiance = 0.0f;
    uint LevelStep = DDGIGetSpatialLevelStep(Level);
    float LevelSpacing = max(ProbeSpacing, 1.0f) * (float)LevelStep;
    float3 GridPosition = (LocalPosition - ProbeGridOrigin.xyz) / LevelSpacing;
    int3 BaseCell = int3(floor(GridPosition));
    float3 CellFraction = frac(GridPosition);
    uint AnchorProbeIndex = 0u;
    bool bHasAnchor = false;
    if (UsePrecomputedProbeNeighbors != 0u)
    {
        bHasAnchor = DDGIFindProbeInCell(
            BaseCell * (int)LevelStep, Level, AnchorProbeIndex);
    }

    [loop]
    for (int Z = 0; Z <= 1; ++Z)
    [loop]
    for (int Y = 0; Y <= 1; ++Y)
    [loop]
    for (int X = 0; X <= 1; ++X)
    {
        int3 Cell = (BaseCell + int3(X, Y, Z)) * (int)LevelStep;
        float3 AxisWeight = lerp(
            1.0f - CellFraction, CellFraction, float3(X, Y, Z));
        float Weight = AxisWeight.x * AxisWeight.y * AxisWeight.z;
        if (Weight <= 0.00001f) continue;

        uint ProbeIndex = 0u;
        bool bFoundProbe = false;
        if (UsePrecomputedProbeNeighbors != 0u)
        {
            // Resolve the lower corner once through the hash. Its precomputed
            // 26-neighbor ring then supplies the other seven trilinear corners.
            if (X == 0 && Y == 0 && Z == 0)
            {
                ProbeIndex = AnchorProbeIndex;
                bFoundProbe = bHasAnchor;
            }
            else if (bHasAnchor)
            {
                uint NeighborLinear = (uint)(Z + 1) * 9u + (uint)(Y + 1) * 3u + (uint)(X + 1);
                uint NeighborSlot = NeighborLinear - (NeighborLinear > 13u ? 1u : 0u);
                ProbeIndex = ProbeNeighborIndices[AnchorProbeIndex * 26u + NeighborSlot];
                bFoundProbe = ProbeIndex != 0xFFFFFFFFu && ProbeIndex < ProbeCount;
            }
            else
            {
                bFoundProbe = DDGIFindProbeInCell(Cell, Level, ProbeIndex);
            }
        }
        else
        {
            bFoundProbe = DDGIFindProbeInCell(Cell, Level, ProbeIndex);
        }
        if (!bFoundProbe) continue;

        if (!DDGIIsProbeInitialized(ProbeIndex)) continue;

        uint2 ProbePixel = uint2(
            ProbeIndex % DDGI_RC_TEXTURE_WIDTH,
            ProbeIndex / DDGI_RC_TEXTURE_WIDTH);
        // Probe positions are already BVH-local; ProbeGridOrigin is kept
        // separately for converting local receiver coordinates to world cells.
        float3 ProbePosition =
            ProbePositionsTexture.Load(int3(ProbePixel, 0)).xyz;
        // Count geometric trilinear support before applying the receiver-side
        // fade. The latter remains in the radiance value, not in clipmap validity.
        OutSpatialWeightSum += Weight;

        float3 SurfaceToProbe = ProbePosition - LocalPosition;
        float SurfaceSide = dot(Normal, SurfaceToProbe);
        float SideThreshold = max(LevelSpacing * 0.01f, 0.5f);
        float SideFadeDistance = max(LevelSpacing * 0.25f, 10.0f);
        Weight *= smoothstep(
            SideThreshold,
            SideThreshold + SideFadeDistance,
            SurfaceSide);
        if (Weight <= 0.00001f) continue;

        Irradiance += DDGIProbeDiffuseIrradiance(
            ProbeIndex, ProbePosition, LocalPosition, Normal) * Weight;
    }

    // Normalize by available geometric support. The receiver-side fade is
    // already applied to each probe's radiance contribution above.
    return Irradiance / max(OutSpatialWeightSum, 0.00001f);
}

float3 DDGISampleLevelValue(
    float3 LocalPosition,
    float3 Normal,
    uint Level,
    out bool OutValid,
    out float OutCoverage)
{
    float SpatialWeightSum = 0.0f;
    float3 Value = DDGISampleProbeLevel(
        LocalPosition, Normal, Level, SpatialWeightSum);
    // Coverage is the fraction of the trilinear lattice represented by
    // initialized probes. Partial support is retained for transition weights.
    OutCoverage = saturate(SpatialWeightSum);
    // A level is supported when its trilinear lattice exists, even if its
    // probes are currently faded by the receiver-side normal test. Treating
    // zero visible weight as invalid switches to the other clipmap at full
    // strength and bypasses T, producing a hard seam instead of a blend.
    // The side fade is already present in Value and therefore remains part
    // of the continuous radiance interpolation.
    OutValid = SpatialWeightSum > 0.00001f;
    return Value;
}

float3 DDGIInterpolateLevelPair(
    float3 LocalPosition,
    float3 Normal,
    uint LevelA,
    uint LevelB,
    float T,
    out bool OutValid)
{
    bool bValidA = false;
    bool bValidB = false;
    float CoverageA = 0.0f;
    float CoverageB = 0.0f;
    float3 ValueA = DDGISampleLevelValue(
        LocalPosition, Normal, LevelA, bValidA, CoverageA);
    float3 ValueB = DDGISampleLevelValue(
        LocalPosition, Normal, LevelB, bValidB, CoverageB);

    const float Blend = saturate(T);
    OutValid = bValidA || bValidB;

    // When both clipmaps have trilinear support, use the actual spatial
    // transition factor directly. Renormalizing by per-level coverage changes
    // T according to which lattice corners happen to be initialized/present;
    // that creates probe-shaped patches instead of a stable clipmap blend.
    if (bValidA && bValidB)
    {
        return lerp(ValueA, ValueB, Blend);
    }

    // Missing support is a startup/layout condition, not a reason to alter
    // the blend curve when both levels are available.
    if (bValidA) return ValueA;
    if (bValidB) return ValueB;
    return 0.0f;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    int2 PixelIndex = int2(DispatchThreadID.xy);
    if (PixelIndex.x >= (int)ScaledViewSizeAndInvSize.x ||
        PixelIndex.y >= (int)ScaledViewSizeAndInvSize.y) return;

    int2 BufferPixelIndex = PixelIndex + int2(ViewRectMin);

    // Isolate the post-process output path from all DDGI inputs. If this mode
    // is visible, the callback's output is reaching the final scene image.
    if (DebugMode == 3u)
    {
        SceneColorOutputUAV[BufferPixelIndex] = float4(1.0f, 0.0f, 1.0f, 1.0f);
        return;
    }

    float2 ScreenUV = (float2(PixelIndex) + 0.5f) * ScaledViewSizeAndInvSize.zw;
    int2 GBufferPixel = int2(ScreenUV * View.ViewSizeAndInvSize.xy);
    float2 GBufferUV = (float2(GBufferPixel) + 0.5f) * View.ViewSizeAndInvSize.zw;
    float4 ScreenPosition = float4(
        GBufferUV * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f),
        0.0f, 1.0f);
    float3 InScreenVector = mul(
        float4(ScreenPosition.xy, 1.0f, 0.0f),
        View.ScreenToTranslatedWorld).xyz;

    float2 BufferUV = (ScreenUV * View.ViewSizeAndInvSize.xy + ViewRectMin) *
        View.BufferSizeAndInvSize.zw;
    float DeviceZ = DepthTexture.SampleLevel(PointClampSampler, BufferUV, 0).r;
    if (DeviceZ <= 0.000001f)
    {
        if (DebugMode == 1u)
        {
            SceneColorOutputUAV[BufferPixelIndex] = float4(0.0f, 0.0f, 0.25f, 1.0f);
        }
        else
        {
            SceneColorOutputUAV[BufferPixelIndex] = SceneColorTexture.Load(int3(BufferPixelIndex, 0));
        }
        return;
    }

    float SceneDepth = ConvertFromDeviceZ(DeviceZ);
    float3 WorldPosition = InScreenVector * SceneDepth + View.WorldCameraOrigin;
    float3 LocalPosition = WorldPosition - BVHWorldOrigin.xyz;
    float3 Normal = normalize(DecodeNormal(
        NormalTexture.SampleLevel(PointClampSampler, BufferUV, 0).xyz));
    float3 BaseColor = DecodeBaseColor(
        BaseColorTexture.SampleLevel(PointClampSampler, BufferUV, 0).rgb);
    float Metallic = MetallicTexture.SampleLevel(PointClampSampler, BufferUV, 0).r;
    float3 Albedo = BaseColor * (1.0f - Metallic);

    // Diagnostic modes 4-7 isolate each spatial probe level. This bypasses
    // distance-based level selection so sparse/coarse-level failures can be
    // distinguished from transition blending.
    if (DebugMode >= 4u && DebugMode <= 7u)
    {
        const uint DebugLevel = DebugMode - 4u;
        bool bDebugLevelValid = false;
        float DebugLevelCoverage = 0.0f;
        float3 DebugLevelIrradiance = DDGISampleLevelValue(
            LocalPosition, Normal, DebugLevel, bDebugLevelValid, DebugLevelCoverage);
        if (!bDebugLevelValid)
        {
            SceneColorOutputUAV[BufferPixelIndex] = float4(1.0f, 0.0f, 1.0f, 1.0f);
        }
        else
        {
            float3 DebugLevelValue = log2(1.0f + max(DebugLevelIrradiance, 0.0f)) * 0.25f;
            SceneColorOutputUAV[BufferPixelIndex] = float4(DebugLevelValue, 1.0f);
        }
        return;
    }

    const float GridRadius = max(ProbeGridDistance, 1.0f);
    // This is the exact integer lattice cell used by DDGIBuildActiveProbePositions.
    // Each level rounds that shared center independently, just like the CPU clipmap builder.
    const int3 BaseWindowCell = int3(ActiveWindowCenterCell.xyz);

    // Spatial levels are nested clipmaps with 15 lattice points per axis. Their
    // half-extents double with each level; only the finest level covering the
    // receiver is sampled, with a narrow overlap at each clipmap boundary.
    float3 Irradiance = 0.0f;
    bool bHasIrradiance = false;
    uint FallbackStartLevel = 0u;
    float PreviousClipmapExtent = 0.0f;
    [loop]
    for (uint ClipmapLevel = 0u; ClipmapLevel < 4u; ++ClipmapLevel)
    {
        const uint LevelStep = DDGIGetSpatialLevelStep(ClipmapLevel);
        const int3 LevelCenterCell = int3(
            DDGIRoundCellToLevelStep(BaseWindowCell.x, LevelStep),
            DDGIRoundCellToLevelStep(BaseWindowCell.y, LevelStep),
            DDGIRoundCellToLevelStep(BaseWindowCell.z, LevelStep));
        const float LevelScale = exp2((float)ClipmapLevel);
        const float LevelSpacing = max(ProbeSpacing, 1.0f) * LevelScale;
        const float3 LevelCenterLocal =
            float3(LevelCenterCell) * max(ProbeSpacing, 1.0f) + ProbeGridOrigin.xyz;

        // Probe positions stay on their immutable, independently snapped
        // level lattice. Only the ownership boundary follows the continuous
        // camera center, removing the visible recenter step.
        const float3 ClipmapOffset = LocalPosition - ActiveWindowCenterLocal.xyz;
        const float ClipmapDistance = length(ClipmapOffset);

        // The generated lattice spans [-7,+7] cells around LevelCenterCell.
        // Reserve one level cell for the blend and another for the
        // trilinear upper corner beyond the blend. The CPU builder retains
        // two cells beyond the nominal radius, while the fixed 15^3 lattice
        // limits the outermost support to seven cells from its snapped center.
        const float3 CenterOffset = ActiveWindowCenterLocal.xyz - LevelCenterLocal;
        const float3 PositiveSupport = 7.0f * LevelSpacing - CenterOffset;
        const float3 NegativeSupport = 7.0f * LevelSpacing + CenterOffset;
        const float3 AxisSupport = min(PositiveSupport, NegativeSupport);
        const float AvailableOuterRadius = max(0.0f,
            min(AxisSupport.x, min(AxisSupport.y, AxisSupport.z)));
        const float NominalClipmapExtent =
            min(GridRadius, max(1.0f, ProbeSpacing) * 6.0f * LevelScale);
        const float ClipmapExtent = min(
            NominalClipmapExtent,
            max(0.0f, AvailableOuterRadius - 2.0f * LevelSpacing));
        if (ClipmapExtent <= PreviousClipmapExtent + 0.5f)
        {
            break;
        }

        // This level has now been considered (either as the primary level
        // or as the fine side of a transition). Any fallback must move only
        // outward; sampling a finer level beyond its clipmap extent can pull
        // stale edge probes into the coarse region and create a visible seam.
        FallbackStartLevel = ClipmapLevel + 1u;

        // Blend within the generated support. The first reserved cell
        // covers this transition; the second keeps its trilinear upper
        // corners inside the generated lattice.
        const float TransitionWidth = min(
            min(
                max(ProbeSpacing * 2.0f * LevelScale, ClipmapExtent * 0.08f),
                max(1.0f, (ClipmapExtent - PreviousClipmapExtent) * 0.30f)),
            // The CPU clipmap builder retains only one level cell beyond
            // the nominal extent for trilinear corner support. Never blend
            // beyond that generated spatial margin.
            max(1.0f, ProbeSpacing * LevelScale));

        if (ClipmapDistance <= ClipmapExtent + TransitionWidth)
        {
            if (ClipmapLevel < 3u && ClipmapDistance > ClipmapExtent - TransitionWidth)
            {
                // Quintic smootherstep has zero slope at both ends,
                // avoiding a perceptible velocity change while crossing levels.
                const float TransitionU = saturate(
                    (ClipmapDistance - (ClipmapExtent - TransitionWidth)) /
                    max(2.0f * TransitionWidth, 0.001f));
                const float T = TransitionU * TransitionU * TransitionU *
                    (TransitionU * (TransitionU * 6.0f - 15.0f) + 10.0f);
                if (DebugMode == 8u)
                {
                    // Red = fine contribution, green = coarse contribution.
                    // This mode visualizes the actual spatial blend factor,
                    // independent of radiance values and probe visibility.
                    SceneColorOutputUAV[BufferPixelIndex] =
                        float4(1.0f - T, T, 0.0f, 1.0f);
                    return;
                }
                if (DebugMode == 9u)
                {
                    bool bFineSupport = false;
                    bool bCoarseSupport = false;
                    float FineCoverage = 0.0f;
                    float CoarseCoverage = 0.0f;
                    DDGISampleLevelValue(
                        LocalPosition, Normal, ClipmapLevel,
                        bFineSupport, FineCoverage);
                    DDGISampleLevelValue(
                        LocalPosition, Normal, ClipmapLevel + 1u,
                        bCoarseSupport, CoarseCoverage);

                    // Green = both levels have initialized trilinear support.
                    // Red = fine only; blue = coarse only; magenta = neither.
                    float3 SupportColor = float3(1.0f, 0.0f, 1.0f);
                    if (bFineSupport && bCoarseSupport)
                        SupportColor = float3(0.0f, 1.0f, 0.0f);
                    else if (bFineSupport)
                        SupportColor = float3(1.0f, 0.0f, 0.0f);
                    else if (bCoarseSupport)
                        SupportColor = float3(0.0f, 0.0f, 1.0f);
                    SceneColorOutputUAV[BufferPixelIndex] =
                        float4(SupportColor, 1.0f);
                    return;
                }
                bool bTransitionValid = false;
                const float3 TransitionIrradiance = DDGIInterpolateLevelPair(
                    LocalPosition, Normal, ClipmapLevel, ClipmapLevel + 1u,
                    T, bTransitionValid);
                if (bTransitionValid)
                {
                    Irradiance = TransitionIrradiance;
                    bHasIrradiance = true;
                    break;
                }
            }

            if (ClipmapDistance <= ClipmapExtent)
            {
                if (DebugMode == 8u)
                {
                    const float LevelCode = (float)ClipmapLevel / 3.0f;
                    SceneColorOutputUAV[BufferPixelIndex] =
                        float4(LevelCode, 0.0f, 1.0f - LevelCode, 1.0f);
                    return;
                }
                bool bCurrentLevelValid = false;
                float CurrentLevelCoverage = 0.0f;
                float3 CurrentLevelIrradiance = DDGISampleLevelValue(
                    LocalPosition, Normal, ClipmapLevel, bCurrentLevelValid,
                    CurrentLevelCoverage);
                if (bCurrentLevelValid)
                {
                    Irradiance = CurrentLevelIrradiance;
                    bHasIrradiance = true;
                    break;
                }
            }
        }

        PreviousClipmapExtent = ClipmapExtent;
    }

    // A missing fine-level sample must not create a dark hole at a clipmap
    // seam. Fall back only to coarser levels; finer levels are outside their
    // declared spatial support and must not leak into this region.
    if (!bHasIrradiance)
    {
        [loop]
        for (uint FallbackLevel = FallbackStartLevel; FallbackLevel < 4u; ++FallbackLevel)
        {
            bool bFallbackValid = false;
            float FallbackCoverage = 0.0f;
            float3 FallbackIrradiance = DDGISampleLevelValue(
                LocalPosition, Normal, FallbackLevel, bFallbackValid,
                FallbackCoverage);
            if (bFallbackValid)
            {
                Irradiance = FallbackIrradiance;
                bHasIrradiance = true;
                break;
            }
        }
    }

    if (!bHasIrradiance)
    {
        if (DebugMode == 1u)
        {
            SceneColorOutputUAV[BufferPixelIndex] = float4(1.0f, 0.0f, 0.0f, 1.0f);
        }
        else
        {
            SceneColorOutputUAV[BufferPixelIndex] = SceneColorTexture.Load(int3(BufferPixelIndex, 0));
        }
        return;
    }
    if (DebugMode == 1u)
    {
        SceneColorOutputUAV[BufferPixelIndex] = float4(0.0f, 0.8f, 0.0f, 1.0f);
        return;
    }
    if (DebugMode == 2u)
    {
        // Irradiance is HDR. A hard saturate(Irradiance * 4) clips most
        // editor-view values to the same white/primary colour and hides
        // spatial variation. Use a per-channel logarithmic display mapping.
        float3 DebugIrradiance = log2(1.0f + max(Irradiance, 0.0f)) * 0.25f;
        SceneColorOutputUAV[BufferPixelIndex] = float4(DebugIrradiance, 1.0f);
        return;
    }

    float PreExposure = ShouldUsePreExposure != 0u ? View.PreExposure : 1.0f;
    // Every in-bounds pixel is written exactly once. The UAV is not assumed
    // to contain initialized data from a previous frame or allocation.
    float4 SceneColor = SceneColorTexture.Load(int3(BufferPixelIndex, 0));
    // DDGIProbeDiffuseIrradiance includes the 1/PI normalization:
    // equal-solid-angle quadrature uses 4*PI/N, then Lambertian BRDF
    // normalization divides by PI, leaving the factor 4/N in the shader.
    // When StaticFraction is zero, the native composite deliberately skips
    // AO. In that configuration, apply the generated SSAO mask to DDGI here.
    // Otherwise the native composite handles AO after this delegate.
    float ScreenSpaceAO = bHasScreenSpaceAO != 0u
        ? saturate(ScreenSpaceAOTexture.SampleLevel(PointClampSampler, BufferUV, 0).r)
        : 1.0f;
    SceneColorOutputUAV[BufferPixelIndex] =
        SceneColor + float4(Irradiance * Albedo * ScreenSpaceAO * PreExposure, 0.0f);
}

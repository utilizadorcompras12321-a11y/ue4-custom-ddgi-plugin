/*
 * Deferred diffuse-lighting application for the single sparse Radiance Cascades GI backend.
 * The cascade lattice owns probe storage, tracing, integration and interpolation.
 */
#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadeLayout.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadePacking.ush"

Texture2D<float4> NormalTexture;
Texture2D<float> DepthTexture;
Texture2D<float4> BaseColorTexture;
Texture2D<float4> MetallicTexture;
Texture2D<float> ScreenSpaceAOTexture;
uint bHasScreenSpaceAO;
Texture2D<float4> DirectionsTexture;
Texture2D<uint> RadianceTexture;
Texture2D<float> HitDistanceTexture;
Texture2D<uint> HitTriangleIndexTexture;
Texture2D<float4> ProbePositionsTexture;
StructuredBuffer<int4> ProbeSpatialHash;
StructuredBuffer<uint> ProbeNeighborIndices;
StructuredBuffer<uint> LogicalToPhysicalSlots;
uint UsePrecomputedProbeNeighbors;
Texture2D<float4> SceneColorTexture;
RWTexture2D<float4> SceneColorOutputUAV;
SamplerState PointClampSampler;

float4 ScaledViewSizeAndInvSize;
float2 ViewRectMin;
uint ProbeCount;
uint TotalRaysPerProbe;
uint BaseRayCount;
uint HashCapacity;
float ProbeSpacing;
float BaseSegmentLength;
float CascadeScale;
float MaxTraceDistance;
uint CascadeCount;
float ProbeGridDistance;
float4 ProbeGridOrigin;
float4 ActiveWindowCenter;
float4 BVHWorldOrigin;
uint ShouldUsePreExposure;
uint DebugMode;

#define DDGI_RC_TEXTURE_WIDTH 4096u

uint DDGIHashProbeCell(int3 Cell, uint Level)
{
    uint Hash = asuint(Cell.x) * 0x8DA6B343u;
    Hash ^= asuint(Cell.y) * 0xD8163841u;
    Hash ^= asuint(Cell.z) * 0xCB1AB31Fu;
    Hash ^= (Level + 1u) * 0x9E3779B9u;
    Hash ^= Hash >> 16;
    Hash *= 0x7FEB352Du;
    Hash ^= Hash >> 15;
    Hash *= 0x846CA68Bu;
    Hash ^= Hash >> 16;
    return Hash;
}

bool DDGIFindProbeInCell(int3 Cell, uint Level, out uint OutProbeIndex)
{
    OutProbeIndex = 0u;
    if (HashCapacity == 0u || ProbeCount == 0u || Level > 7u) return false;
    uint Slot = DDGIHashProbeCell(Cell, Level) & (HashCapacity - 1u);
    // ProbeCount is not a safe probe bound: a collision cluster can be longer
    // than the number of entries. Search at most one complete hash-table cycle.
    [loop]
    for (uint Attempt = 0u; Attempt < HashCapacity; ++Attempt)
    {
        int4 Entry = ProbeSpatialHash[Slot];
        if (Entry.w < 0) return false;
        if (all(Entry.xyz == Cell) &&
            (((uint)Entry.w & 7u) == Level))
        {
            OutProbeIndex = (uint)Entry.w >> 3u;
            return OutProbeIndex < ProbeCount;
        }
        Slot = (Slot + 1u) & (HashCapacity - 1u);
    }
    return false;
}

bool DDGIIsProbeInitialized(uint ProbeIndex)
{
    uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];
    uint LinearIndex = PhysicalProbeIndex * TotalRaysPerProbe;
    uint2 Pixel = uint2(
        LinearIndex % DDGI_RC_TEXTURE_WIDTH,
        LinearIndex / DDGI_RC_TEXTURE_WIDTH);
    // Initialization writes this sentinel. The trace pass overwrites it for
    // every ray, including misses, so a black-but-untraced probe is distinct
    // from a legitimately dark, fully traced probe.
    return HitTriangleIndexTexture.Load(int3(Pixel, 0)) != 0xFFFFFFFFu;
}

float3 DDGIProbeDiffuseIrradiance(
    uint ProbeIndex,
    float3 ProbePosition,
    float3 LocalPosition,
    float3 Normal)
{
    float3 Irradiance = 0.0f;
    const uint SafeRayCount = min(BaseRayCount, min(TotalRaysPerProbe, 64u));
    if (SafeRayCount == 0u) return Irradiance;

    // The trace range limits how far a probe sees into the scene; it does
    // not limit how far that probe's captured radiance may illuminate.
    // Applying MaxTraceDistance to probe-to-receiver distance creates
    // spherical cutoffs around probes and visible circular GI artifacts.
    uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];
    // Do not impose a probe-centred visibility radius here. A finite
    // probe-to-receiver cutoff creates spherical rings around every probe.

    // Integrate the base angular directions. The higher cascades refine the
    // radiance captured along those directions; they are not extra quadrature
    // samples for the final diffuse irradiance.
    [loop]
    for (uint RayIndex = 0u; RayIndex < SafeRayCount; ++RayIndex)
    {
        uint2 DirectionPixel = uint2(
            RayIndex % DDGI_RC_TEXTURE_WIDTH,
            RayIndex / DDGI_RC_TEXTURE_WIDTH);
        float3 Direction = normalize(
            DirectionsTexture.Load(int3(DirectionPixel, 0)).xyz);
        float Cosine = saturate(dot(Normal, -Direction));
        if (Cosine > 0.0f)
        {
            uint LinearIndex = PhysicalProbeIndex * TotalRaysPerProbe + RayIndex;
            uint2 RadiancePixel = uint2(
                LinearIndex % DDGI_RC_TEXTURE_WIDTH,
                LinearIndex / DDGI_RC_TEXTURE_WIDTH);
            Irradiance += DDGIUnpackR11G11B10(RadianceTexture.Load(int3(RadiancePixel, 0))) * Cosine;
        }
    }

    // Visibility is handled by the receiver-side normal weighting and the
    // traced radiance. Do not infer visibility from one angular ray: that
    // approximation produced probe-centred circular cutoffs and rings.

    // Each base direction represents 4*PI/N steradians. The 1/PI
    // Lambertian BRDF normalization cancels PI, so this returns E/PI,
    // ready to multiply directly by diffuse albedo in the apply pass.
    return Irradiance * (4.0f / (float)SafeRayCount);
}
uint DDGIGetSpatialLevelStep(uint Level)
{
    // Keep in sync with DDGIGetSpatialLevelStep in DDGIRadianceCascadeResources.cpp
    // and the deterministic clipmap builder in DDGIMasterSubsystem.cpp.
    return 1u << min(Level, 3u);
}

float3 DDGISampleProbeLevel(
    float3 LocalPosition,
    float3 Normal,
    uint Level,
    out float OutSpatialWeightSum,
    out float OutVisibleWeightSum)
{
    OutSpatialWeightSum = 0.0f;
    OutVisibleWeightSum = 0.0f;
    float3 Irradiance = 0.0f;
    uint LevelStep = DDGIGetSpatialLevelStep(Level);
    float LevelSpacing = max(ProbeSpacing, 1.0f) * (float)LevelStep;
    float3 GridPosition = (LocalPosition - ProbeGridOrigin.xyz) / LevelSpacing;
    int3 BaseCell = int3(floor(GridPosition));
    float3 CellFraction = frac(GridPosition);
    uint AnchorProbeIndex = 0u;
    bool bHasAnchor = false;
    if (UsePrecomputedProbeNeighbors != 0u)
    {
        bHasAnchor = DDGIFindProbeInCell(
            BaseCell * (int)LevelStep, Level, AnchorProbeIndex);
    }

    [loop]
    for (int Z = 0; Z <= 1; ++Z)
    [loop]
    for (int Y = 0; Y <= 1; ++Y)
    [loop]
    for (int X = 0; X <= 1; ++X)
    {
        int3 Cell = (BaseCell + int3(X, Y, Z)) * (int)LevelStep;
        float3 AxisWeight = lerp(
            1.0f - CellFraction, CellFraction, float3(X, Y, Z));
        float Weight = AxisWeight.x * AxisWeight.y * AxisWeight.z;
        if (Weight <= 0.00001f) continue;

        uint ProbeIndex = 0u;
        bool bFoundProbe = false;
        if (UsePrecomputedProbeNeighbors != 0u)
        {
            // Resolve the lower corner once through the hash. Its precomputed
            // 26-neighbor ring then supplies the other seven trilinear corners.
            if (X == 0 && Y == 0 && Z == 0)
            {
                ProbeIndex = AnchorProbeIndex;
                bFoundProbe = bHasAnchor;
            }
            else if (bHasAnchor)
            {
                uint NeighborLinear = (uint)(Z + 1) * 9u + (uint)(Y + 1) * 3u + (uint)(X + 1);
                uint NeighborSlot = NeighborLinear - (NeighborLinear > 13u ? 1u : 0u);
                ProbeIndex = ProbeNeighborIndices[AnchorProbeIndex * 26u + NeighborSlot];
                bFoundProbe = ProbeIndex != 0xFFFFFFFFu && ProbeIndex < ProbeCount;
            }
            else
            {
                bFoundProbe = DDGIFindProbeInCell(Cell, Level, ProbeIndex);
            }
        }
        else
        {
            bFoundProbe = DDGIFindProbeInCell(Cell, Level, ProbeIndex);
        }
        if (!bFoundProbe) continue;

        if (!DDGIIsProbeInitialized(ProbeIndex)) continue;

        uint2 ProbePixel = uint2(
            ProbeIndex % DDGI_RC_TEXTURE_WIDTH,
            ProbeIndex / DDGI_RC_TEXTURE_WIDTH);
        // Probe positions are already BVH-local; ProbeGridOrigin is kept
        // separately for converting local receiver coordinates to world cells.
        float3 ProbePosition =
            ProbePositionsTexture.Load(int3(ProbePixel, 0)).xyz;
        // Track geometric support separately from the surface-side visibility
        // fade. Sparse coarse levels can then be renormalized without cancelling
        // the fade that rejects probes behind the receiving surface.
        OutSpatialWeightSum += Weight;

        float3 SurfaceToProbe = ProbePosition - LocalPosition;
        float SurfaceSide = dot(Normal, SurfaceToProbe);
        float SideThreshold = max(LevelSpacing * 0.01f, 0.5f);
        float SideFadeDistance = max(LevelSpacing * 0.25f, 10.0f);
        Weight *= smoothstep(
            SideThreshold,
            SideThreshold + SideFadeDistance,
            SurfaceSide);
        if (Weight <= 0.00001f) continue;

        Irradiance += DDGIProbeDiffuseIrradiance(
            ProbeIndex, ProbePosition, LocalPosition, Normal) * Weight;
        OutVisibleWeightSum += Weight;
    }

    return Irradiance / max(OutVisibleWeightSum, 0.00001f);
}

float3 DDGISampleLevelValue(
    float3 LocalPosition,
    float3 Normal,
    uint Level,
    out bool OutValid,
    out float OutConfidence)
{
    float SpatialWeightSum = 0.0f;
    float VisibleWeightSum = 0.0f;
    float3 Value = DDGISampleProbeLevel(
        LocalPosition, Normal, Level, SpatialWeightSum, VisibleWeightSum);
    OutConfidence = saturate(
        VisibleWeightSum / max(SpatialWeightSum, 0.00001f));
    OutValid = SpatialWeightSum > 0.00001f && VisibleWeightSum > 0.00001f;
    return Value;
}

float3 DDGIInterpolateLevelPair(
    float3 LocalPosition,
    float3 Normal,
    uint LevelA,
    uint LevelB,
    float T,
    out bool OutValid)
{
    bool bValidA = false;
    bool bValidB = false;
    float ConfidenceA = 0.0f;
    float ConfidenceB = 0.0f;
    float3 ValueA = DDGISampleLevelValue(
        LocalPosition, Normal, LevelA, bValidA, ConfidenceA);
    float3 ValueB = DDGISampleLevelValue(
        LocalPosition, Normal, LevelB, bValidB, ConfidenceB);

    // Keep the geometric transition as a true continuous interpolation.
    // Renormalizing by the combined confidence makes the weaker cascade
    // disappear abruptly as soon as the other gains a little support.
    float Blend = saturate(T);
    float3 ConfidentA = ValueA * ConfidenceA;
    float3 ConfidentB = ValueB * ConfidenceB;
    OutValid = (ConfidenceA > 0.00001f && bValidA) ||
        (ConfidenceB > 0.00001f && bValidB);
    return lerp(ConfidentA, ConfidentB, Blend);
}

[numthreads(8, 8, 1)]
void MainCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    int2 PixelIndex = int2(DispatchThreadID.xy);
    if (PixelIndex.x >= (int)ScaledViewSizeAndInvSize.x ||
        PixelIndex.y >= (int)ScaledViewSizeAndInvSize.y) return;

    int2 BufferPixelIndex = PixelIndex + int2(ViewRectMin);

    // Isolate the post-process output path from all DDGI inputs. If this mode
    // is visible, the callback's output is reaching the final scene image.
    if (DebugMode == 3u)
    {
        SceneColorOutputUAV[BufferPixelIndex] = float4(1.0f, 0.0f, 1.0f, 1.0f);
        return;
    }

    float2 ScreenUV = (float2(PixelIndex) + 0.5f) * ScaledViewSizeAndInvSize.zw;
    int2 GBufferPixel = int2(ScreenUV * View.ViewSizeAndInvSize.xy);
    float2 GBufferUV = (float2(GBufferPixel) + 0.5f) * View.ViewSizeAndInvSize.zw;
    float4 ScreenPosition = float4(
        GBufferUV * float2(2.0f, -2.0f) + float2(-1.0f, 1.0f),
        0.0f, 1.0f);
    float3 InScreenVector = mul(
        float4(ScreenPosition.xy, 1.0f, 0.0f),
        View.ScreenToTranslatedWorld).xyz;

    float2 BufferUV = (ScreenUV * View.ViewSizeAndInvSize.xy + ViewRectMin) *
        View.BufferSizeAndInvSize.zw;
    float DeviceZ = DepthTexture.SampleLevel(PointClampSampler, BufferUV, 0).r;
    if (DeviceZ <= 0.000001f)
    {
        if (DebugMode == 1u)
        {
            SceneColorOutputUAV[BufferPixelIndex] = float4(0.0f, 0.0f, 0.25f, 1.0f);
        }
        else
        {
            SceneColorOutputUAV[BufferPixelIndex] = SceneColorTexture.Load(int3(BufferPixelIndex, 0));
        }
        return;
    }

    float SceneDepth = ConvertFromDeviceZ(DeviceZ);
    float3 WorldPosition = InScreenVector * SceneDepth + View.WorldCameraOrigin;
    float3 LocalPosition = WorldPosition - BVHWorldOrigin.xyz;
    float3 Normal = normalize(DecodeNormal(
        NormalTexture.SampleLevel(PointClampSampler, BufferUV, 0).xyz));
    float3 BaseColor = DecodeBaseColor(
        BaseColorTexture.SampleLevel(PointClampSampler, BufferUV, 0).rgb);
    float Metallic = MetallicTexture.SampleLevel(PointClampSampler, BufferUV, 0).r;
    float3 Albedo = BaseColor * (1.0f - Metallic);

    // Diagnostic modes 4-7 isolate each spatial probe level. This bypasses
    // distance-based level selection so sparse/coarse-level failures can be
    // distinguished from transition blending.
    if (DebugMode >= 4u && DebugMode <= 7u)
    {
        const uint DebugLevel = DebugMode - 4u;
        bool bDebugLevelValid = false;
        float DebugLevelConfidence = 0.0f;
        float3 DebugLevelIrradiance = DDGISampleLevelValue(
            LocalPosition, Normal, DebugLevel, bDebugLevelValid, DebugLevelConfidence) *
            DebugLevelConfidence;
        if (!bDebugLevelValid)
        {
            SceneColorOutputUAV[BufferPixelIndex] = float4(1.0f, 0.0f, 1.0f, 1.0f);
        }
        else
        {
            float3 DebugLevelValue = log2(1.0f + max(DebugLevelIrradiance, 0.0f)) * 0.25f;
            SceneColorOutputUAV[BufferPixelIndex] = float4(DebugLevelValue, 1.0f);
        }
        return;
    }

    const float GridRadius = max(ProbeGridDistance, 1.0f);
    const float3 ClipmapOffset = abs(LocalPosition - ActiveWindowCenter.xyz);
    const float ClipmapDistance = max(ClipmapOffset.x, max(ClipmapOffset.y, ClipmapOffset.z));

    // Spatial levels are nested clipmaps with 16 cells per axis. Their
    // half-extents double with each level; only the finest level covering the
    // receiver is sampled, with a narrow overlap at each clipmap boundary.
    float3 Irradiance = 0.0f;
    bool bHasIrradiance = false;
    float PreviousClipmapExtent = 0.0f;
    [loop]
    for (uint ClipmapLevel = 0u; ClipmapLevel < 4u; ++ClipmapLevel)
    {
        const float LevelScale = exp2((float)ClipmapLevel);
        const float ClipmapExtent = min(GridRadius, max(1.0f, ProbeSpacing) * 6.0f * LevelScale);
        if (ClipmapExtent <= PreviousClipmapExtent + 0.5f)
        {
            break;
        }

        // Blend across half of the fine/coarse overlap. A fixed two-cell
        // width was too narrow relative to the coarse lattice and made
        // confidence changes read as a visible clipmap boundary.
        const float TransitionWidth = min(
            max(ProbeSpacing * 4.0f * LevelScale, ClipmapExtent * 0.18f),
            max(1.0f, (ClipmapExtent - PreviousClipmapExtent) * 0.85f));

        if (ClipmapDistance <= ClipmapExtent + TransitionWidth)
        {
            if (ClipmapLevel < 3u && ClipmapDistance > ClipmapExtent - TransitionWidth)
            {
                const float T = smoothstep(
                    ClipmapExtent - TransitionWidth,
                    ClipmapExtent + TransitionWidth,
                    ClipmapDistance);
                bool bTransitionValid = false;
                const float3 TransitionIrradiance = DDGIInterpolateLevelPair(
                    LocalPosition, Normal, ClipmapLevel, ClipmapLevel + 1u,
                    T, bTransitionValid);
                if (bTransitionValid)
                {
                    Irradiance = TransitionIrradiance;
                    bHasIrradiance = true;
                    break;
                }
            }

            if (ClipmapDistance <= ClipmapExtent)
            {
                bool bCurrentLevelValid = false;
                float CurrentLevelConfidence = 0.0f;
                float3 CurrentLevelIrradiance = DDGISampleLevelValue(
                    LocalPosition, Normal, ClipmapLevel, bCurrentLevelValid,
                    CurrentLevelConfidence) * CurrentLevelConfidence;
                if (bCurrentLevelValid)
                {
                    Irradiance = CurrentLevelIrradiance;
                    bHasIrradiance = true;
                    break;
                }
            }
        }

        PreviousClipmapExtent = ClipmapExtent;
    }

    // A missing fine-level sample must not create a dark hole at a clipmap
    // seam. Fall back through coarser levels in a fixed, deterministic order.
    if (!bHasIrradiance)
    {
        [loop]
        for (uint FallbackLevel = 0u; FallbackLevel < 4u; ++FallbackLevel)
        {
            bool bFallbackValid = false;
            float FallbackConfidence = 0.0f;
            float3 FallbackIrradiance = DDGISampleLevelValue(
                LocalPosition, Normal, FallbackLevel, bFallbackValid,
                FallbackConfidence) * FallbackConfidence;
            if (bFallbackValid)
            {
                Irradiance = FallbackIrradiance;
                bHasIrradiance = true;
                break;
            }
        }
    }

    if (!bHasIrradiance)
    {
        if (DebugMode == 1u)
        {
            SceneColorOutputUAV[BufferPixelIndex] = float4(1.0f, 0.0f, 0.0f, 1.0f);
        }
        else
        {
            SceneColorOutputUAV[BufferPixelIndex] = SceneColorTexture.Load(int3(BufferPixelIndex, 0));
        }
        return;
    }
    if (DebugMode == 1u)
    {
        SceneColorOutputUAV[BufferPixelIndex] = float4(0.0f, 0.8f, 0.0f, 1.0f);
        return;
    }
    if (DebugMode == 2u)
    {
        // Irradiance is HDR. A hard saturate(Irradiance * 4) clips most
        // editor-view values to the same white/primary colour and hides
        // spatial variation. Use a per-channel logarithmic display mapping.
        float3 DebugIrradiance = log2(1.0f + max(Irradiance, 0.0f)) * 0.25f;
        SceneColorOutputUAV[BufferPixelIndex] = float4(DebugIrradiance, 1.0f);
        return;
    }

    float PreExposure = ShouldUsePreExposure != 0u ? View.PreExposure : 1.0f;
    // Every in-bounds pixel is written exactly once. The UAV is not assumed
    // to contain initialized data from a previous frame or allocation.
    float4 SceneColor = SceneColorTexture.Load(int3(BufferPixelIndex, 0));
    // DDGIProbeDiffuseIrradiance includes the 1/PI normalization:
    // equal-solid-angle quadrature uses 4*PI/N, then Lambertian BRDF
    // normalization divides by PI, leaving the factor 4/N in the shader.
    // DDGI is added after deferred lighting, so it would otherwise bypass
    // the SSAO contribution already present in SceneColor. Reapply the AO
    // visibility to the new indirect diffuse term only (never to existing color).
    float ScreenSpaceAO = bHasScreenSpaceAO != 0u
        ? saturate(ScreenSpaceAOTexture.SampleLevel(PointClampSampler, BufferUV, 0).r)
        : 1.0f;
    SceneColorOutputUAV[BufferPixelIndex] =
        SceneColor + float4(Irradiance * Albedo * ScreenSpaceAO * PreExposure, 0.0f);
}

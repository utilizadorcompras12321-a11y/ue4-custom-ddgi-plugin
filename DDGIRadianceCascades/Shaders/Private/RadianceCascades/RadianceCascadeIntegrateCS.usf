#include "/Engine/Public/Platform.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadePacking.ush"

uint TextureWidth;
uint TotalIntegrationTexels;
uint DispatchGroupsX;
uint TotalRaysPerProbe;
uint BaseRayCount;
float TemporalBlendAlpha;
uint ProbeCount;
uint ProbeStartIndex;
uint CascadeStorageOffset;
uint CascadeRayCount;
uint NextCascadeStorageOffset;
uint bCopyGatherToFinal;

Texture2D<float4> GatheredRadianceTexture;
Texture2D<float> HitDistanceTexture;
Texture2D<uint> HitTriangleIndexTexture;
StructuredBuffer<uint> LogicalToPhysicalSlots;
RWTexture2D<uint> RadianceUAV;

// This sentinel cannot be produced by DDGIPackR11G11B10 (all channel
// exponents are capped at 30), so first-use probes can seed history directly.
static const uint DDGIInvalidRadianceHistory = 0xFFFFFFFFu;

void DDGIStoreIntegratedRadiance(uint2 Pixel, float3 NewRadiance)
{
    const bool bBlendHistory =
        CascadeStorageOffset == 0u &&
        CascadeRayCount == BaseRayCount &&
        BaseRayCount < TotalRaysPerProbe &&
        TemporalBlendAlpha < 1.0f;

    if (bBlendHistory)
    {
        const uint PreviousPacked = RadianceUAV[Pixel];
        if (PreviousPacked != DDGIInvalidRadianceHistory)
        {
            const float3 PreviousRadiance = DDGIUnpackR11G11B10(PreviousPacked);
            NewRadiance = lerp(PreviousRadiance, NewRadiance, saturate(TemporalBlendAlpha));
        }
    }

    RadianceUAV[Pixel] = DDGIPackR11G11B10(NewRadiance);
}

[numthreads(64, 1, 1)]
void RadianceCascadeIntegrateCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalIntegrationTexels ||
        TotalRaysPerProbe == 0u ||
        CascadeRayCount == 0u ||
        ProbeCount == 0u)
    {
        return;
    }

    uint ScheduledProbeIndex = LinearIndex / CascadeRayCount;
    uint ProbeIndex = (ProbeStartIndex + ScheduledProbeIndex) % ProbeCount;
    uint LocalRayIndex = LinearIndex - ScheduledProbeIndex * CascadeRayCount;
    uint PackedRayIndex = CascadeStorageOffset + LocalRayIndex;
    uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];
    uint LinearTextureIndex = PhysicalProbeIndex * TotalRaysPerProbe + PackedRayIndex;
    uint2 Pixel = uint2(LinearTextureIndex % TextureWidth, LinearTextureIndex / TextureWidth);

    // First copy the newly gathered raw cascade data into persistent final
    // storage. Subsequent dispatches integrate parent levels in place.
    if (bCopyGatherToFinal != 0u)
    {
        // Keep base-cascade values intact until the final integration pass
        // can blend them with the newly integrated result.
        if (BaseRayCount < TotalRaysPerProbe && LocalRayIndex < BaseRayCount)
        {
            return;
        }
        RadianceUAV[Pixel] = DDGIPackR11G11B10(GatheredRadianceTexture.Load(int3(Pixel, 0)).rgb);
        return;
    }

    const float ParentHitDistance = HitDistanceTexture.Load(int3(Pixel, 0));
    if (ParentHitDistance >= 0.0f)
    {
        // A hit inside this cascade's interval owns this angular cell and
        // terminates transport to farther intervals.
        DDGIStoreIntegratedRadiance(
            Pixel, GatheredRadianceTexture.Load(int3(Pixel, 0)).rgb);
        return;
    }

    // Only misses need the triangle tag to distinguish an unobstructed miss
    // from a ray blocked by geometry before this cascade's interval.
    const uint ParentTriangleTag = HitTriangleIndexTexture.Load(int3(Pixel, 0));
    if (ParentTriangleTag > 0u)
    {
        // A tagged negative distance is a real blocker before this interval.
        // Preserve its zero radiance rather than allowing farther children
        // to leak through the occluder.
        DDGIStoreIntegratedRadiance(Pixel, float3(0.0f, 0.0f, 0.0f));
        return;
    }

    // An unobstructed miss continues transport by averaging the two
    // equal-solid-angle child cells from the next, farther cascade.
    const uint FirstChildRay = LocalRayIndex * 2u;
    const uint FirstChildLinearIndex =
        PhysicalProbeIndex * TotalRaysPerProbe +
        NextCascadeStorageOffset +
        FirstChildRay;
    const uint SecondChildLinearIndex = FirstChildLinearIndex + 1u;
    const uint2 FirstChildPixel = uint2(
        FirstChildLinearIndex % TextureWidth,
        FirstChildLinearIndex / TextureWidth);
    const uint2 SecondChildPixel = uint2(
        SecondChildLinearIndex % TextureWidth,
        SecondChildLinearIndex / TextureWidth);
    const float3 FirstChildRadiance =
        DDGIUnpackR11G11B10(RadianceUAV[FirstChildPixel]);
    const float3 SecondChildRadiance =
        DDGIUnpackR11G11B10(RadianceUAV[SecondChildPixel]);
    const float3 MergedChildRadiance =
        0.5f * (FirstChildRadiance + SecondChildRadiance);
    DDGIStoreIntegratedRadiance(Pixel, MergedChildRadiance);
}

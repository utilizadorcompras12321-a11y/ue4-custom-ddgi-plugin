#include "/Engine/Public/Platform.ush"

uint TextureWidth;
uint TotalIntegrationTexels;
uint DispatchGroupsX;
uint TotalRaysPerProbe;
uint CascadeStorageOffset;
uint CascadeRayCount;
uint NextCascadeStorageOffset;
uint EffectiveSplitFactor;

RWTexture2D<float4> RadianceUAV;
Texture2D<float> HitDistanceTexture;

[numthreads(64, 1, 1)]
void RadianceCascadeIntegrateCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalIntegrationTexels ||
        TotalRaysPerProbe == 0u ||
        CascadeRayCount == 0u)
    {
        return;
    }

    // Dispatch indices cover only the parent rays of this cascade.
    uint ProbeIndex = LinearIndex / CascadeRayCount;
    uint LocalRayIndex = LinearIndex - ProbeIndex * CascadeRayCount;
    uint PackedRayIndex = CascadeStorageOffset + LocalRayIndex;
    uint LinearTextureIndex = ProbeIndex * TotalRaysPerProbe + PackedRayIndex;
    uint2 Pixel = uint2(LinearTextureIndex % TextureWidth, LinearTextureIndex / TextureWidth);

    // A hit in this interval, or an earlier interval, terminates transport.
    // The gathered radiance is already valid, so leave the texel untouched.
    if (HitDistanceTexture.Load(int3(Pixel, 0)) >= 0.0f)
    {
        return;
    }

    const uint SafeSplitFactor = max(EffectiveSplitFactor, 1u);
    const uint ChildLinearIndexBase =
        ProbeIndex * TotalRaysPerProbe +
        NextCascadeStorageOffset +
        LocalRayIndex * SafeSplitFactor;

    uint2 ChildPixel = uint2(
        ChildLinearIndexBase % TextureWidth,
        ChildLinearIndexBase / TextureWidth);
    float3 IntegratedRadiance = 0.0f;

    // Child rays are in a disjoint cascade range. This dispatch writes only
    // the parent range, allowing in-place integration without texture copies.
    [loop]
    for (uint ChildIndex = 0u; ChildIndex < SafeSplitFactor; ++ChildIndex)
    {
        IntegratedRadiance += RadianceUAV[ChildPixel].rgb;
        ++ChildPixel.x;
        if (ChildPixel.x >= TextureWidth)
        {
            ChildPixel.x = 0u;
            ++ChildPixel.y;
        }
    }

    RadianceUAV[Pixel] = float4(IntegratedRadiance / (float)SafeSplitFactor, 1.0f);
}

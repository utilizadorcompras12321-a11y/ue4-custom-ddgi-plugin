#include "/Engine/Public/Platform.ush"

uint TextureWidth;
uint TotalTexels;
uint DispatchGroupsX;
uint ProbeCount;
uint TraceStartIndex;
uint TotalRaysPerProbe;
uint BaseRayCount;
uint CascadeCount;
float MaxTraceDistance;

Texture2D<float> HitDistanceTexture;
Texture2D<uint> HitTriangleIndexTexture;
StructuredBuffer<uint> LogicalToPhysicalSlots;
RWTexture2D<float4> VisibilityMomentsUAV;

// Store an empirical hit-distance histogram instead of only its mean and
// variance. Moments can hide a nearby blocker when most child rays hit much
// farther away. Seven logarithmic distance bins plus one miss bin preserve
// that mixed distribution in two RGBA texels per base angular cell.
[numthreads(64, 1, 1)]
void RadianceCascadeVisibilityMomentsCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    const uint LinearIndex =
        DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalTexels || ProbeCount == 0u ||
        TotalRaysPerProbe == 0u || BaseRayCount == 0u ||
        CascadeCount < 2u || TotalRaysPerProbe < BaseRayCount * 2u)
    {
        return;
    }

    const uint ScheduledProbeIndex = LinearIndex / BaseRayCount;
    const uint BaseRayIndex = LinearIndex - ScheduledProbeIndex * BaseRayCount;
    if (ScheduledProbeIndex >= TotalTexels / BaseRayCount)
    {
        return;
    }

    const uint ProbeIndex = (TraceStartIndex + ScheduledProbeIndex) % ProbeCount;
    const uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];

    const uint SafeCascadeIndex = min(CascadeCount - 1u, 7u);
    const uint ChildCount = 1u << SafeCascadeIndex;
    const uint CascadeStorageOffset = BaseRayCount * (ChildCount - 1u);
    const uint FirstChildRay = CascadeStorageOffset + BaseRayIndex * ChildCount;
    if (ChildCount < 2u ||
        FirstChildRay >= TotalRaysPerProbe ||
        ChildCount > TotalRaysPerProbe - FirstChildRay)
    {
        return;
    }

    float4 Histogram0 = 0.0f; // hit-distance bins 0..3
    float4 Histogram1 = 0.0f; // hit-distance bins 4..6, then misses
    bool bSamplesValid = true;
    const float SafeMaxTraceDistance = max(MaxTraceDistance, 1.0f);
    const float LogDistanceRange = max(log2(1.0f + SafeMaxTraceDistance), 1.0e-6f);

    [loop]
    for (uint ChildIndex = 0u; ChildIndex < ChildCount; ++ChildIndex)
    {
        const uint PackedRayIndex = FirstChildRay + ChildIndex;
        const uint LinearRayIndex =
            PhysicalProbeIndex * TotalRaysPerProbe + PackedRayIndex;
        const uint2 Pixel = uint2(
            LinearRayIndex % TextureWidth,
            LinearRayIndex / TextureWidth);
        const uint TriangleTag = HitTriangleIndexTexture.Load(int3(Pixel, 0));

        // Zero is a valid miss. The all-ones value means this ray was never
        // traced, so never publish a partially accumulated histogram.
        if (TriangleTag == 0xFFFFFFFFu)
        {
            bSamplesValid = false;
            break;
        }

        if (TriangleTag == 0u)
        {
            Histogram1.w += 1.0f;
            continue;
        }

        // Negative tagged distances are hits before this cascade interval;
        // abs() restores their probe-relative first-hit distance.
        const float HitDistance =
            abs(HitDistanceTexture.Load(int3(Pixel, 0)));
        // A tagged zero-distance hit is valid (the probe may touch geometry) and
        // belongs in the nearest bin; only non-finite or negative distances are invalid.
        if (!isfinite(HitDistance) || HitDistance < 0.0f)
        {
            bSamplesValid = false;
            break;
        }

        const float ClampedDistance = min(HitDistance, SafeMaxTraceDistance);
        const float BinCoordinate = saturate(
            log2(1.0f + ClampedDistance) / LogDistanceRange) * 7.0f;
        const uint BinIndex = min((uint)BinCoordinate, 6u);

        if (BinIndex == 0u) Histogram0.x += 1.0f;
        else if (BinIndex == 1u) Histogram0.y += 1.0f;
        else if (BinIndex == 2u) Histogram0.z += 1.0f;
        else if (BinIndex == 3u) Histogram0.w += 1.0f;
        else if (BinIndex == 4u) Histogram1.x += 1.0f;
        else if (BinIndex == 5u) Histogram1.y += 1.0f;
        else Histogram1.z += 1.0f;
    }

    const uint BaseLinearIndex =
        PhysicalProbeIndex * TotalRaysPerProbe + BaseRayIndex;
    const uint SecondaryLinearIndex = BaseLinearIndex + BaseRayCount;
    const uint2 BasePixel = uint2(
        BaseLinearIndex % TextureWidth,
        BaseLinearIndex / TextureWidth);
    const uint2 SecondaryPixel = uint2(
        SecondaryLinearIndex % TextureWidth,
        SecondaryLinearIndex / TextureWidth);

    // A valid histogram sums to ChildCount. Negative values are an explicit
    // invalid sentinel; all counts are small exact integers in half-float.
    VisibilityMomentsUAV[BasePixel] = bSamplesValid
        ? Histogram0
        : float4(-1.0f, -1.0f, -1.0f, -1.0f);
    VisibilityMomentsUAV[SecondaryPixel] = bSamplesValid
        ? Histogram1
        : float4(-1.0f, -1.0f, -1.0f, -1.0f);
}

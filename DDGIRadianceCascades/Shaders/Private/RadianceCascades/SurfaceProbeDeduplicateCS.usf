#include "/Engine/Public/Platform.ush"

StructuredBuffer<float4> SurfaceProbeCandidatePositions;
StructuredBuffer<float4> SurfaceProbeCandidateNormals;

RWStructuredBuffer<float4> SurfaceProbePositions;
RWStructuredBuffer<float4> SurfaceProbeNormals;
RWStructuredBuffer<float4> SurfaceProbeIntegratedRadiance;
RWStructuredBuffer<uint4> SurfaceProbeStableKeys;
RWStructuredBuffer<uint> SurfaceProbeLastSeenFrames;
RWStructuredBuffer<uint4> SurfaceProbeHash;
RWStructuredBuffer<uint> SurfaceProbeCounters;

uint ProbeCapacity;
uint HashCapacity;
uint FrameNumber;

static const uint DDGI_HASH_LOCKED = 0xffffffffu;
static const float DDGI_SURFACE_CELL_SIZE = 50.0f;

uint DDGIHashSurfaceKey(uint3 Cell, uint NormalKey)
{
    uint Hash = Cell.x * 0x8DA6B343u;
    Hash ^= Cell.y * 0xD8163841u;
    Hash ^= Cell.z * 0xCB1AB31Fu;
    Hash ^= NormalKey * 0x9E3779B9u;
    Hash ^= Hash >> 16;
    Hash *= 0x7FEB352Du;
    Hash ^= Hash >> 15;
    Hash *= 0x846CA68Bu;
    Hash ^= Hash >> 16;
    return Hash;
}

uint DDGIEncodeNormal(float3 Normal)
{
    Normal /= max(abs(Normal.x) + abs(Normal.y) + abs(Normal.z), 1.0e-6f);
    float2 Oct = Normal.xy;
    if (Normal.z < 0.0f)
    {
        float2 OctSign = float2(Oct.x >= 0.0f ? 1.0f : -1.0f, Oct.y >= 0.0f ? 1.0f : -1.0f);
        Oct = (1.0f - abs(Oct.yx)) * OctSign;
    }
    uint2 Quantized = (uint2)round(saturate(Oct * 0.5f + 0.5f) * 255.0f);
    return Quantized.x | (Quantized.y << 8);
}

static const uint DDGI_SURFACE_PROBE_RETENTION_FRAMES = 120u;

[numthreads(64, 1, 1)]
void SurfaceProbeDeduplicateCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint CandidateIndex = DispatchThreadID.x;
    uint CandidateCount = SurfaceProbeCounters[0];
    if (CandidateIndex >= CandidateCount)
    {
        return;
    }

    float4 CandidatePosition = SurfaceProbeCandidatePositions[CandidateIndex];
    float4 CandidateNormal = SurfaceProbeCandidateNormals[CandidateIndex];
    if (CandidatePosition.w <= 0.5f || CandidateNormal.w <= 0.5f)
    {
        return;
    }

    int3 QuantizedCell = (int3)floor(CandidatePosition.xyz / DDGI_SURFACE_CELL_SIZE);
    uint3 CellBits = asuint(QuantizedCell);
    uint NormalKey = DDGIEncodeNormal(normalize(CandidateNormal.xyz));
    uint4 Key = uint4(CellBits, NormalKey);
    uint Bucket = DDGIHashSurfaceKey(CellBits, NormalKey) & (HashCapacity - 1u);

    // Remember the first expired entry, but continue probing. A matching key
    // may still exist later in the collision chain and must take precedence.
    uint ReusableBucket = 0xffffffffu;
    uint ReusableSlot = 0xffffffffu;
    uint ReusableBucketValue = 0u;

    [loop]
    for (uint Probe = 0u; Probe < HashCapacity; ++Probe)
    {
        uint BucketIndex = (Bucket + Probe) & (HashCapacity - 1u);
        uint ExistingSlot = SurfaceProbeHash[BucketIndex].w;

        if (ExistingSlot == DDGI_HASH_LOCKED)
        {
            // A concurrent insertion owns this bucket. Retry this candidate
            // on a later frame instead of spinning on a GPU-side lock.
            return;
        }

        if (ExistingSlot == 0u)
        {
            // The exact stable key is absent. Before allocating a second probe,
            // look for the same quantized normal in the 26 adjacent 50 cm cells.
            // This catches small surface motion across a cell boundary without
            // treating a nearby, differently oriented surface as the same probe.
            uint NeighborBucket = 0xffffffffu;
            uint NeighborSlot = 0xffffffffu;
            uint NeighborBucketValue = 0u;
            uint3 NeighborCellBitsSelected = uint3(0u, 0u, 0u);
            float NeighborDistanceSquared = 3.402823466e+38f;

            [loop]
            for (int NeighborZ = -1; NeighborZ <= 1; ++NeighborZ)
            {
                [loop]
                for (int NeighborY = -1; NeighborY <= 1; ++NeighborY)
                {
                    [loop]
                    for (int NeighborX = -1; NeighborX <= 1; ++NeighborX)
                    {
                        if (NeighborX == 0 && NeighborY == 0 && NeighborZ == 0)
                        {
                            continue;
                        }

                        int3 NeighborCell = QuantizedCell + int3(NeighborX, NeighborY, NeighborZ);
                        uint3 NeighborCellBits = asuint(NeighborCell);
                        uint NeighborStartBucket =
                            DDGIHashSurfaceKey(NeighborCellBits, NormalKey) & (HashCapacity - 1u);

                        [loop]
                        for (uint NeighborProbe = 0u; NeighborProbe < HashCapacity; ++NeighborProbe)
                        {
                            uint NeighborBucketIndex =
                                (NeighborStartBucket + NeighborProbe) & (HashCapacity - 1u);
                            uint NeighborEncodedSlot = SurfaceProbeHash[NeighborBucketIndex].w;

                            // A locked bucket means another candidate is changing
                            // this chain. Defer this candidate rather than risk a
                            // duplicate insertion based on an incomplete lookup.
                            if (NeighborEncodedSlot == DDGI_HASH_LOCKED)
                            {
                                return;
                            }
                            if (NeighborEncodedSlot == 0u)
                            {
                                break;
                            }

                            uint NeighborProbeSlot = NeighborEncodedSlot - 1u;
                            if (NeighborProbeSlot >= ProbeCapacity)
                            {
                                InterlockedAdd(SurfaceProbeCounters[5], 1u);
                                return;
                            }

                            uint4 NeighborKey = SurfaceProbeStableKeys[NeighborProbeSlot];
                            if (all(SurfaceProbeHash[NeighborBucketIndex].xyz == NeighborCellBits) &&
                                all(NeighborKey.xyz == NeighborCellBits) &&
                                NeighborKey.w == NormalKey)
                            {
                                float3 NeighborPosition = SurfaceProbePositions[NeighborProbeSlot].xyz;
                                float3 NeighborNormal = normalize(SurfaceProbeNormals[NeighborProbeSlot].xyz);
                                float3 CandidateNormalUnit = normalize(CandidateNormal.xyz);
                                float3 NeighborDelta = CandidatePosition.xyz - NeighborPosition;
                                float NeighborDeltaSquared = dot(NeighborDelta, NeighborDelta);
                                float NeighborNormalAgreement = dot(NeighborNormal, CandidateNormalUnit);
                                uint NeighborAge = FrameNumber - SurfaceProbeLastSeenFrames[NeighborProbeSlot];

                                if (NeighborAge <= DDGI_SURFACE_PROBE_RETENTION_FRAMES &&
                                    NeighborDeltaSquared <= 25.0f &&
                                    NeighborNormalAgreement >= 0.98f &&
                                    NeighborDeltaSquared < NeighborDistanceSquared)
                                {
                                    NeighborBucket = NeighborBucketIndex;
                                    NeighborSlot = NeighborProbeSlot;
                                    NeighborBucketValue = NeighborEncodedSlot;
                                    NeighborCellBitsSelected = NeighborCellBits;
                                    NeighborDistanceSquared = NeighborDeltaSquared;
                                }
                                break;
                            }
                        }
                    }
                }
            }

            if (NeighborBucket != 0xffffffffu)
            {
                uint OriginalNeighborSlot;
                InterlockedCompareExchange(
                    SurfaceProbeHash[NeighborBucket].w,
                    NeighborBucketValue,
                    DDGI_HASH_LOCKED,
                    OriginalNeighborSlot);

                if (OriginalNeighborSlot != NeighborBucketValue)
                {
                    return;
                }

                // Revalidate after locking. Keep the original key and anchor
                // position unchanged: moving the key's position repeatedly
                // across cells would make it drift away from its hash identity.
                uint4 LockedNeighborKey = SurfaceProbeStableKeys[NeighborSlot];
                float3 LockedNeighborPosition = SurfaceProbePositions[NeighborSlot].xyz;
                float3 LockedNeighborNormal = normalize(SurfaceProbeNormals[NeighborSlot].xyz);
                float3 LockedDelta = CandidatePosition.xyz - LockedNeighborPosition;
                bool bNeighborStillCompatible =
                    all(SurfaceProbeHash[NeighborBucket].xyz == LockedNeighborKey.xyz) &&
                    all(LockedNeighborKey.xyz == NeighborCellBitsSelected) &&
                    LockedNeighborKey.w == NormalKey &&
                    dot(LockedDelta, LockedDelta) <= 25.0f &&
                    dot(LockedNeighborNormal, normalize(CandidateNormal.xyz)) >= 0.98f &&
                    (FrameNumber - SurfaceProbeLastSeenFrames[NeighborSlot]) <= DDGI_SURFACE_PROBE_RETENTION_FRAMES;

                if (bNeighborStillCompatible)
                {
                    SurfaceProbeLastSeenFrames[NeighborSlot] = FrameNumber;
                    DeviceMemoryBarrier();
                    SurfaceProbeHash[NeighborBucket].w = NeighborBucketValue;
                    return;
                }

                DeviceMemoryBarrier();
                SurfaceProbeHash[NeighborBucket].w = NeighborBucketValue;
            }

            // An empty bucket terminates the search: the key cannot exist
            // later in this linear-probing chain.
            if (ReusableBucket != 0xffffffffu)
            {
                uint OriginalSlot;
                InterlockedCompareExchange(
                    SurfaceProbeHash[ReusableBucket].w,
                    ReusableBucketValue,
                    DDGI_HASH_LOCKED,
                    OriginalSlot);

                if (OriginalSlot != ReusableBucketValue)
                {
                    return;
                }

                // Recheck after acquiring the lock: a matching candidate may
                // have refreshed this entry after our initial stale-age read.
                uint LockedLastSeenFrame = SurfaceProbeLastSeenFrames[ReusableSlot];
                if ((FrameNumber - LockedLastSeenFrame) <= DDGI_SURFACE_PROBE_RETENTION_FRAMES)
                {
                    DeviceMemoryBarrier();
                    SurfaceProbeHash[ReusableBucket].w = ReusableBucketValue;
                    return;
                }

                // Reuse the physical slot in-place. Keeping the bucket
                // occupied preserves the collision chain for all other keys.
                SurfaceProbePositions[ReusableSlot] = CandidatePosition;
                SurfaceProbeNormals[ReusableSlot] = CandidateNormal;
            SurfaceProbeIntegratedRadiance[ReusableSlot] = 0.0f;
                SurfaceProbeStableKeys[ReusableSlot] = Key;
                SurfaceProbeLastSeenFrames[ReusableSlot] = FrameNumber;
                SurfaceProbeHash[ReusableBucket].xyz = CellBits;
                DeviceMemoryBarrier();
                SurfaceProbeHash[ReusableBucket].w = ReusableSlot + 1u;
                return;
            }

            uint OriginalEmptySlot;
            InterlockedCompareExchange(
                SurfaceProbeHash[BucketIndex].w, 0u, DDGI_HASH_LOCKED, OriginalEmptySlot);
            if (OriginalEmptySlot != 0u)
            {
                return;
            }

            uint NewSlot;
            InterlockedAdd(SurfaceProbeCounters[4], 1u, NewSlot);
            if (NewSlot >= ProbeCapacity)
            {
                InterlockedMin(SurfaceProbeCounters[4], ProbeCapacity);
                InterlockedAdd(SurfaceProbeCounters[5], 1u);
                DeviceMemoryBarrier();
                SurfaceProbeHash[BucketIndex].w = 0u;
                return;
            }

            SurfaceProbePositions[NewSlot] = CandidatePosition;
            SurfaceProbeNormals[NewSlot] = CandidateNormal;
            SurfaceProbeIntegratedRadiance[NewSlot] = 0.0f;
            SurfaceProbeStableKeys[NewSlot] = Key;
            SurfaceProbeLastSeenFrames[NewSlot] = FrameNumber;
            SurfaceProbeHash[BucketIndex].xyz = CellBits;
            DeviceMemoryBarrier();
            SurfaceProbeHash[BucketIndex].w = NewSlot + 1u;
            return;
        }

        uint ExistingProbeSlot = ExistingSlot - 1u;
        if (ExistingProbeSlot >= ProbeCapacity)
        {
            // Invalid hash data: do not mutate the table based on a corrupt slot.
            InterlockedAdd(SurfaceProbeCounters[5], 1u);
            return;
        }

        uint3 ExistingCell = SurfaceProbeHash[BucketIndex].xyz;
        uint4 ExistingKey = SurfaceProbeStableKeys[ExistingProbeSlot];
        if (all(ExistingCell == CellBits) &&
            all(ExistingKey.xyz == CellBits) &&
            ExistingKey.w == NormalKey)
        {
            // Serialize the timestamp refresh with stale-slot recycling.
            // Without taking the bucket lock, an old-key refresh could race
            // with a new-key overwrite after the eviction thread's age test.
            uint OriginalMatchingSlot;
            InterlockedCompareExchange(
                SurfaceProbeHash[BucketIndex].w,
                ExistingSlot,
                DDGI_HASH_LOCKED,
                OriginalMatchingSlot);
            if (OriginalMatchingSlot != ExistingSlot)
            {
                return;
            }

            // A stable key only identifies a coarse spatial cell and an
            // octahedrally quantized normal. Validate the actual surface before
            // carrying radiance history forward.
            float3 PreviousPosition = SurfaceProbePositions[ExistingProbeSlot].xyz;
            float3 PreviousNormal = normalize(SurfaceProbeNormals[ExistingProbeSlot].xyz);
            float3 CurrentPosition = CandidatePosition.xyz;
            float3 CurrentNormal = normalize(CandidateNormal.xyz);
            float PositionDeltaSquared = dot(
                CurrentPosition - PreviousPosition,
                CurrentPosition - PreviousPosition);
            float NormalAgreement = dot(PreviousNormal, CurrentNormal);
            const float PositionTolerance = 5.0f; // centimeters
            const float NormalAgreementThreshold = 0.98f;
            bool bSurfaceHistoryCompatible =
                PositionDeltaSquared <= PositionTolerance * PositionTolerance &&
                NormalAgreement >= NormalAgreementThreshold;

            // Follow small sub-cell movement. If the surface changed beyond
            // tolerance, discard radiance integrated for the previous surface.
            SurfaceProbePositions[ExistingProbeSlot] = CandidatePosition;
            SurfaceProbeNormals[ExistingProbeSlot] = CandidateNormal;
            if (!bSurfaceHistoryCompatible)
            {
                SurfaceProbeIntegratedRadiance[ExistingProbeSlot] = 0.0f;
            }

            SurfaceProbeLastSeenFrames[ExistingProbeSlot] = FrameNumber;
            DeviceMemoryBarrier();
            SurfaceProbeHash[BucketIndex].w = ExistingSlot;
            return;
        }

        uint LastSeenFrame = SurfaceProbeLastSeenFrames[ExistingProbeSlot];
        uint FrameAge = FrameNumber - LastSeenFrame;
        if (FrameAge > DDGI_SURFACE_PROBE_RETENTION_FRAMES &&
            ReusableBucket == 0xffffffffu)
        {
            ReusableBucket = BucketIndex;
            ReusableSlot = ExistingProbeSlot;
            ReusableBucketValue = ExistingSlot;
        }
    }

    // The table may have no empty buckets. A previously found expired entry
    // is still reusable after the full chain has been checked for duplicates.
    if (ReusableBucket != 0xffffffffu)
    {
        uint OriginalSlot;
        InterlockedCompareExchange(
            SurfaceProbeHash[ReusableBucket].w,
            ReusableBucketValue,
            DDGI_HASH_LOCKED,
            OriginalSlot);

        if (OriginalSlot != ReusableBucketValue)
        {
            return;
        }

        // As above, validate the age while holding the bucket lock so a
        // concurrent refresh cannot be overwritten by stale-slot recycling.
        uint LockedLastSeenFrame = SurfaceProbeLastSeenFrames[ReusableSlot];
        if ((FrameNumber - LockedLastSeenFrame) <= DDGI_SURFACE_PROBE_RETENTION_FRAMES)
        {
            DeviceMemoryBarrier();
            SurfaceProbeHash[ReusableBucket].w = ReusableBucketValue;
            return;
        }

        SurfaceProbePositions[ReusableSlot] = CandidatePosition;
        SurfaceProbeNormals[ReusableSlot] = CandidateNormal;
            SurfaceProbeIntegratedRadiance[ReusableSlot] = 0.0f;
        SurfaceProbeStableKeys[ReusableSlot] = Key;
        SurfaceProbeLastSeenFrames[ReusableSlot] = FrameNumber;
        SurfaceProbeHash[ReusableBucket].xyz = CellBits;
        DeviceMemoryBarrier();
        SurfaceProbeHash[ReusableBucket].w = ReusableSlot + 1u;
        return;
    }

    InterlockedAdd(SurfaceProbeCounters[5], 1u);
}

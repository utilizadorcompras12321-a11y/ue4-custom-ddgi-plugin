#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadeLayout.ush"

uint TextureWidth;
uint TotalTexels;
uint DispatchGroupsX;
uint ProbeCount;
uint TotalRaysPerProbe;
uint NodeCount;
uint TriangleCount;
uint CascadeCount;
float BaseSegmentLength;
float CascadeScale;
float MaxTraceDistance;
float4 StaticBackgroundColor;
float StaticBackgroundIntensity;
float GIIntensity;
float4 ProbeGridOrigin;
float BackgroundTransitionStart;
float BackgroundTransitionEnd;
uint bEnableStaticBackground;

float4 DirectionalLightDirection;
float4 DirectionalLightColor;
float DirectionalLightIntensity;
uint bHasDirectionalLight;

Texture2D<float4> DirectionsTexture;
Texture2D<float4> RayOriginsTexture;
StructuredBuffer<float4> BVHNodes;
StructuredBuffer<float4> BVHTriangles;
RWTexture2D<float4> RadianceUAV;
RWTexture2D<float> HitDistanceUAV;
RWTexture2D<uint> HitTriangleIndexUAV;

// Position-relative ray bias: enough to cover several float ULPs at the
// current coordinate magnitude, but never use a scene-independent 0.5 cm.
float ComputeRayOriginBias(float3 Position)
{
    const float FloatEpsilon = 1.192092896e-7f;
    const float MinimumBias = 0.001f;
    float CoordinateMagnitude = max(
        max(abs(Position.x), abs(Position.y)),
        abs(Position.z));
    return max(MinimumBias, CoordinateMagnitude * FloatEpsilon * 4.0f);
}


// Compute a geometric normal without forming an unscaled cross product.
// Scaling both edges by their largest component keeps intermediate products
// bounded and makes the degeneracy threshold independent of triangle size.
float3 ComputeTriangleGeometricNormal(float3 A, float3 B, float3 C)
{
    float3 EdgeAB = B - A;
    float3 EdgeAC = C - A;
    float EdgeScale = max(
        max(max(abs(EdgeAB.x), abs(EdgeAB.y)), abs(EdgeAB.z)),
        max(max(abs(EdgeAC.x), abs(EdgeAC.y)), abs(EdgeAC.z)));
    if (!(EdgeScale > 0.0f) || !isfinite(EdgeScale))
    {
        return 0.0f;
    }

    float3 ScaledCross = cross(EdgeAB / EdgeScale, EdgeAC / EdgeScale);
    float NormalLengthSquared = dot(ScaledCross, ScaledCross);
    if (!(NormalLengthSquared > 1.0e-12f) || !isfinite(NormalLengthSquared))
    {
        return 0.0f;
    }

    return ScaledCross * rsqrt(NormalLengthSquared);
}

// Update a ray interval against one AABB slab. Exact zero is the only
// parallel case: treating small non-zero directions as parallel can miss a
// valid hit when the ray starts just outside the slab.
bool UpdateSlabInterval(
    float RayOrigin,
    float RayDirection,
    float SlabMin,
    float SlabMax,
    inout float NearDistance,
    inout float FarDistance)
{
    if (RayDirection == 0.0f)
    {
        return RayOrigin >= SlabMin && RayOrigin <= SlabMax;
    }

    float T0 = (SlabMin - RayOrigin) / RayDirection;
    float T1 = (SlabMax - RayOrigin) / RayDirection;
    if (!isfinite(T0) || !isfinite(T1))
    {
        return false;
    }

    NearDistance = max(NearDistance, min(T0, T1));
    FarDistance = min(FarDistance, max(T0, T1));
    return FarDistance >= NearDistance;
}

bool IntersectBoundsInterval(
    float3 Origin,
    float3 Direction,
    float3 BoundsMin,
    float3 BoundsMax,
    float MaxDistance,
    out float NearDistance)
{
    NearDistance = 0.0f;
    if (!all(isfinite(Origin)) || !all(isfinite(Direction)) ||
        !all(isfinite(BoundsMin)) || !all(isfinite(BoundsMax)) ||
        any(BoundsMin > BoundsMax) ||
        !isfinite(MaxDistance) || MaxDistance <= 0.0f)
    {
        return false;
    }

    float FarDistance = MaxDistance;
    if (!UpdateSlabInterval(Origin.x, Direction.x, BoundsMin.x, BoundsMax.x, NearDistance, FarDistance) ||
        !UpdateSlabInterval(Origin.y, Direction.y, BoundsMin.y, BoundsMax.y, NearDistance, FarDistance) ||
        !UpdateSlabInterval(Origin.z, Direction.z, BoundsMin.z, BoundsMax.z, NearDistance, FarDistance))
    {
        return false;
    }

    return FarDistance >= NearDistance;
}

bool IntersectBounds(float3 Origin, float3 Direction, float3 BoundsMin, float3 BoundsMax, float MaxDistance)
{
    float NearDistance;
    return IntersectBoundsInterval(
        Origin, Direction, BoundsMin, BoundsMax, MaxDistance, NearDistance);
}

bool IntersectBoundsWithNear(
    float3 Origin,
    float3 Direction,
    float3 BoundsMin,
    float3 BoundsMax,
    float MaxDistance,
    out float NearDistance)
{
    return IntersectBoundsInterval(
        Origin, Direction, BoundsMin, BoundsMax, MaxDistance, NearDistance);
}


bool IntersectTriangle(float3 Origin, float3 Direction, float3 A, float3 B, float3 C, out float HitDistance)
{
    // Watertight ray/triangle test (Woop/Benthin/Wald style): translate the
    // triangle to ray space, shear along the dominant ray axis, then evaluate
    // all three edge functions in the same 2D coordinate system. Adjacent
    // triangles therefore use matching edge equations instead of independent
    // barycentric divisions.
    float3 ATranslated = A - Origin;
    float3 BTranslated = B - Origin;
    float3 CTranslated = C - Origin;

    // Reject non-finite inputs before axis selection or projected arithmetic.
    if (!all(isfinite(ATranslated)) ||
        !all(isfinite(BTranslated)) ||
        !all(isfinite(CTranslated)) ||
        !all(isfinite(Direction)))
    {
        HitDistance = -1.0f;
        return false;
    }

    float3 AbsDirection = abs(Direction);
    uint DominantAxis = AbsDirection.x > AbsDirection.y
        ? (AbsDirection.x > AbsDirection.z ? 0u : 2u)
        : (AbsDirection.y > AbsDirection.z ? 1u : 2u);
    if (AbsDirection[DominantAxis] <= 1.0e-20f)
    {
        HitDistance = -1.0f;
        return false;
    }

    uint AxisX = (DominantAxis + 1u) % 3u;
    uint AxisY = (AxisX + 1u) % 3u;
    if (Direction[DominantAxis] < 0.0f)
    {
        uint TempAxis = AxisX;
        AxisX = AxisY;
        AxisY = TempAxis;
    }

    float ShearX = Direction[AxisX] / Direction[DominantAxis];
    float ShearY = Direction[AxisY] / Direction[DominantAxis];
    float ScaleZ = rcp(Direction[DominantAxis]);

    float Ax = ATranslated[AxisX] - ShearX * ATranslated[DominantAxis];
    float Ay = ATranslated[AxisY] - ShearY * ATranslated[DominantAxis];
    float Bx = BTranslated[AxisX] - ShearX * BTranslated[DominantAxis];
    float By = BTranslated[AxisY] - ShearY * BTranslated[DominantAxis];
    float Cx = CTranslated[AxisX] - ShearX * CTranslated[DominantAxis];
    float Cy = CTranslated[AxisY] - ShearY * CTranslated[DominantAxis];

    if (!isfinite(ShearX) || !isfinite(ShearY) || !isfinite(ScaleZ) ||
        !isfinite(Ax) || !isfinite(Ay) ||
        !isfinite(Bx) || !isfinite(By) ||
        !isfinite(Cx) || !isfinite(Cy))
    {
        HitDistance = -1.0f;
        return false;
    }

    float U = Cx * By - Cy * Bx;
    float V = Ax * Cy - Ay * Cx;
    float W = Bx * Ay - By * Ax;

    // A hit is outside when edge functions have mixed signs. Exact zero is
    // accepted so shared edges are not discarded by strict inequalities.
    bool bHasNegative = U < 0.0f || V < 0.0f || W < 0.0f;
    bool bHasPositive = U > 0.0f || V > 0.0f || W > 0.0f;
    if (bHasNegative && bHasPositive)
    {
        HitDistance = -1.0f;
        return false;
    }

    float Determinant = U + V + W;
    if (!isfinite(U) || !isfinite(V) || !isfinite(W) ||
        !isfinite(Determinant) || Determinant == 0.0f)
    {
        HitDistance = -1.0f;
        return false;
    }

    float Az = ATranslated[DominantAxis] * ScaleZ;
    float Bz = BTranslated[DominantAxis] * ScaleZ;
    float Cz = CTranslated[DominantAxis] * ScaleZ;
    float ScaledDistance = U * Az + V * Bz + W * Cz;
    if (!isfinite(Az) || !isfinite(Bz) || !isfinite(Cz) || !isfinite(ScaledDistance))
    {
        HitDistance = -1.0f;
        return false;
    }

    // Test the signed distance before division. This avoids accepting
    // intersections behind the origin for either triangle winding.
    if ((Determinant > 0.0f && ScaledDistance <= 0.0f) ||
        (Determinant < 0.0f && ScaledDistance >= 0.0f))
    {
        HitDistance = -1.0f;
        return false;
    }

    HitDistance = ScaledDistance / Determinant;
    if (!isfinite(HitDistance) || HitDistance <= 0.0f)
    {
        HitDistance = -1.0f;
        return false;
    }
    return true;
}


bool TraceAnyHit(float3 Origin, float3 Direction, float MaxDistance, uint IgnoreTriangleIndex)
{
    if (NodeCount == 0u || TriangleCount == 0u || MaxDistance <= 0.0f)
    {
        return false;
    }

    uint Stack[64];
    float NearStack[64];
    uint StackSize = 0u;
    uint IterationCount = 0u;
    Stack[StackSize] = 0u;
    NearStack[StackSize++] = -1.0f; // Root bounds have not been tested yet.

    [loop]
    while (StackSize > 0u && IterationCount < NodeCount)
    {
        ++IterationCount;
        --StackSize;
        uint NodeIndex = Stack[StackSize];
        float NodeNear = NearStack[StackSize];
        if (NodeIndex >= NodeCount)
        {
            continue;
        }

        uint NodeBase = NodeIndex * 3u;
        // Child bounds were tested before insertion. Only the root needs
        // its bounds tested here; avoid repeating every child AABB test.
        if (NodeNear < 0.0f && !IntersectBounds(Origin, Direction,
            BVHNodes[NodeBase + 0u].xyz,
            BVHNodes[NodeBase + 1u].xyz,
            MaxDistance))
        {
            continue;
        }

        float4 Metadata = BVHNodes[NodeBase + 2u];
        uint FirstTriangle = (uint)max(Metadata.z, 0.0f);
        uint LeafTriangleCount = (uint)max(Metadata.w, 0.0f);
        if (LeafTriangleCount > 0u)
        {
            [loop]
            for (uint LocalTriangle = 0u; LocalTriangle < LeafTriangleCount; ++LocalTriangle)
            {
                uint TriangleIndex = FirstTriangle + LocalTriangle;
                if (TriangleIndex >= TriangleCount || TriangleIndex == IgnoreTriangleIndex)
                {
                    continue;
                }

                uint TriangleBase = TriangleIndex * 4u;
                float ShadowHitDistance;
                if (IntersectTriangle(Origin, Direction,
                    BVHTriangles[TriangleBase + 0u].xyz,
                    BVHTriangles[TriangleBase + 1u].xyz,
                    BVHTriangles[TriangleBase + 2u].xyz,
                    ShadowHitDistance) && ShadowHitDistance < MaxDistance)
                {
                    return true;
                }
            }
        }
        else
        {
            uint LeftChild = (uint)max(Metadata.x, 0.0f);
            uint RightChild = (uint)max(Metadata.y, 0.0f);
            float LeftNear = 0.0f;
            float RightNear = 0.0f;
            bool bHitLeft = false;
            bool bHitRight = false;
            if (LeftChild < NodeCount)
            {
                uint LeftBase = LeftChild * 3u;
                bHitLeft = IntersectBoundsWithNear(Origin, Direction,
                    BVHNodes[LeftBase + 0u].xyz, BVHNodes[LeftBase + 1u].xyz,
                    MaxDistance, LeftNear);
            }
            if (RightChild < NodeCount)
            {
                uint RightBase = RightChild * 3u;
                bHitRight = IntersectBoundsWithNear(Origin, Direction,
                    BVHNodes[RightBase + 0u].xyz, BVHNodes[RightBase + 1u].xyz,
                    MaxDistance, RightNear);
            }
            // The CPU builder rejects BVHs deeper than 48 levels. A depth-first
            // traversal therefore needs at most 49 stack entries, leaving room
            // for both children in this 64-entry stack. Never silently discard
            // a hit child because of a defensive capacity branch.
            if (bHitLeft && bHitRight)
            {
                if (LeftNear <= RightNear)
                {
                    Stack[StackSize] = RightChild;
                    NearStack[StackSize++] = RightNear;
                    Stack[StackSize] = LeftChild;
                    NearStack[StackSize++] = LeftNear;
                }
                else
                {
                    Stack[StackSize] = LeftChild;
                    NearStack[StackSize++] = LeftNear;
                    Stack[StackSize] = RightChild;
                    NearStack[StackSize++] = RightNear;
                }
            }
            else if (bHitLeft)
            {
                Stack[StackSize] = LeftChild;
                NearStack[StackSize++] = LeftNear;
            }
            else if (bHitRight)
            {
                Stack[StackSize] = RightChild;
                NearStack[StackSize++] = RightNear;
            }
        }
    }
    return false;
}


bool TraceClosestHit(
    float3 Origin,
    float3 Direction,
    float MaxDistance,
    uint IgnoreTriangleIndex,
    out float ClosestDistance,
    out uint ClosestTriangleIndex)
{
    ClosestDistance = MaxDistance;
    ClosestTriangleIndex = 0u;
    if (NodeCount == 0u || TriangleCount == 0u)
    {
        return false;
    }

    uint Stack[64];
    float NearStack[64];
    uint StackSize = 0u;
    uint IterationCount = 0u;
    Stack[StackSize] = 0u;
    NearStack[StackSize++] = -1.0f; // Root bounds have not been tested yet.
    bool bFoundHit = false;

    [loop]
    while (StackSize > 0u && IterationCount < NodeCount)
    {
        ++IterationCount;
        --StackSize;
        uint NodeIndex = Stack[StackSize];
        float NodeNear = NearStack[StackSize];
        if (NodeIndex >= NodeCount || (NodeNear >= 0.0f && NodeNear > ClosestDistance))
        {
            continue;
        }

        uint NodeBase = NodeIndex * 3u;
        // Child bounds were tested before insertion. Reuse their saved
        // near distance and only test the root bounds on first visit.
        if (NodeNear < 0.0f && !IntersectBounds(Origin, Direction,
            BVHNodes[NodeBase + 0u].xyz,
            BVHNodes[NodeBase + 1u].xyz,
            ClosestDistance))
        {
            continue;
        }

        float4 Metadata = BVHNodes[NodeBase + 2u];
        uint FirstTriangle = (uint)max(Metadata.z, 0.0f);
        uint LeafTriangleCount = (uint)max(Metadata.w, 0.0f);
        if (LeafTriangleCount > 0u)
        {
            [loop]
            for (uint LocalTriangle = 0u; LocalTriangle < LeafTriangleCount; ++LocalTriangle)
            {
                uint TriangleIndex = FirstTriangle + LocalTriangle;
                if (TriangleIndex >= TriangleCount || TriangleIndex == IgnoreTriangleIndex)
                {
                    continue;
                }

                uint TriangleBase = TriangleIndex * 4u;
                float CandidateDistance;
                if (IntersectTriangle(Origin, Direction,
                    BVHTriangles[TriangleBase + 0u].xyz,
                    BVHTriangles[TriangleBase + 1u].xyz,
                    BVHTriangles[TriangleBase + 2u].xyz,
                    CandidateDistance) && CandidateDistance < ClosestDistance)
                {
                    ClosestDistance = CandidateDistance;
                    ClosestTriangleIndex = TriangleIndex;
                    bFoundHit = true;
                }
            }
        }
        else
        {
            uint LeftChild = (uint)max(Metadata.x, 0.0f);
            uint RightChild = (uint)max(Metadata.y, 0.0f);
            float LeftNear = 0.0f;
            float RightNear = 0.0f;
            bool bHitLeft = false;
            bool bHitRight = false;
            if (LeftChild < NodeCount)
            {
                uint LeftBase = LeftChild * 3u;
                bHitLeft = IntersectBoundsWithNear(Origin, Direction,
                    BVHNodes[LeftBase + 0u].xyz, BVHNodes[LeftBase + 1u].xyz,
                    ClosestDistance, LeftNear);
            }
            if (RightChild < NodeCount)
            {
                uint RightBase = RightChild * 3u;
                bHitRight = IntersectBoundsWithNear(Origin, Direction,
                    BVHNodes[RightBase + 0u].xyz, BVHNodes[RightBase + 1u].xyz,
                    ClosestDistance, RightNear);
            }
            // The CPU builder rejects BVHs deeper than 48 levels. A depth-first
            // traversal therefore needs at most 49 stack entries, leaving room
            // for both children in this 64-entry stack. Never silently discard
            // a hit child because of a defensive capacity branch.
            if (bHitLeft && bHitRight)
            {
                if (LeftNear <= RightNear)
                {
                    Stack[StackSize] = RightChild;
                    NearStack[StackSize++] = RightNear;
                    Stack[StackSize] = LeftChild;
                    NearStack[StackSize++] = LeftNear;
                }
                else
                {
                    Stack[StackSize] = LeftChild;
                    NearStack[StackSize++] = LeftNear;
                    Stack[StackSize] = RightChild;
                    NearStack[StackSize++] = RightNear;
                }
            }
            else if (bHitLeft)
            {
                Stack[StackSize] = LeftChild;
                NearStack[StackSize++] = LeftNear;
            }
            else if (bHitRight)
            {
                Stack[StackSize] = RightChild;
                NearStack[StackSize++] = RightNear;
            }
        }
    }

    return bFoundHit;
}

float3 EvaluateHitSurfaceRadiance(
    uint TriangleIndex,
    float3 HitPosition,
    float3 IncomingDirection)
{
    uint TriangleBase = TriangleIndex * 4u;
    float3 A = BVHTriangles[TriangleBase + 0u].xyz;
    float3 B = BVHTriangles[TriangleBase + 1u].xyz;
    float3 C = BVHTriangles[TriangleBase + 2u].xyz;
    float3 Normal = ComputeTriangleGeometricNormal(A, B, C);
    if (dot(Normal, IncomingDirection) > 0.0f)
    {
        Normal = -Normal;
    }

    float3 Emissive = float3(
        BVHTriangles[TriangleBase + 0u].w,
        BVHTriangles[TriangleBase + 1u].w,
        BVHTriangles[TriangleBase + 2u].w) * GIIntensity;

    float3 Direct = 0.0f;
    float3 BaseColor = max(BVHTriangles[TriangleBase + 3u].xyz, 0.0f);
    // Black diffuse surfaces cannot receive direct diffuse light. Avoid
    // launching a shadow traversal for emissive-only / zero-albedo triangles.
    if (dot(Normal, Normal) > 0.0f && bHasDirectionalLight != 0u && any(BaseColor > 1.0e-6f))
    {
        float3 ToLight = normalize(DirectionalLightDirection.xyz);
        float NdotL = saturate(dot(Normal, ToLight));
        if (NdotL > 0.0f)
        {
            float3 ShadowOrigin = HitPosition + Normal * ComputeRayOriginBias(HitPosition);
            const float DirectionalShadowDistance = 1000000.0f;
            if (!TraceAnyHit(ShadowOrigin, ToLight, DirectionalShadowDistance, TriangleIndex))
            {
                Direct = BaseColor * DirectionalLightColor.rgb *
                    DirectionalLightIntensity * NdotL *
                    (1.0f / 3.14159265f) * GIIntensity;
            }
        }
    }

    return Emissive + Direct;
}

// Fixed four-point cosine-weighted hemisphere quadrature. The sample pattern
// is indexed only by the ray/hit, never by frame number or a random seed.
float3 TraceDeterministicDiffuseBounce(
    float3 HitPosition,
    float3 SurfaceNormal,
    uint IgnoreTriangleIndex)
{
    float3 Normal = normalize(SurfaceNormal);

    // Stable orthonormal basis (Frisvad/Duff construction). Unlike a
    // cross-product against a selected world-up vector, this avoids a basis
    // switch seam when the surface normal approaches the pole threshold.
    float BasisSign = Normal.z >= 0.0f ? 1.0f : -1.0f;
    float BasisA = -1.0f / (BasisSign + Normal.z);
    float BasisB = Normal.x * Normal.y * BasisA;
    float3 Tangent = float3(
        1.0f + BasisSign * Normal.x * Normal.x * BasisA,
        BasisSign * BasisB,
        -BasisSign * Normal.x);
    float3 Bitangent = float3(
        BasisB,
        BasisSign + Normal.y * Normal.y * BasisA,
        -Normal.y);

    // The origin offset is identical for all four deterministic samples.
    // Compute it once per primary hit instead of repeating the bias calculation.
    float3 SecondaryOrigin = HitPosition + Normal * ComputeRayOriginBias(HitPosition);

    float3 IncomingRadianceSum = 0.0f;
    const uint SampleCount = 4u;
    const float CosTheta = 0.6666666666666667f;
    const float SinTheta = 0.7453559924999299f;
    const float HalfPi = 1.5707963267948966f;

    // Fourfold-symmetric cosine-weighted quadrature. The azimuths are evenly
    // spaced and the cosine is the exact first moment (2/3) of a cosine
    // hemisphere distribution. No random values or frame-dependent inputs.
    [unroll]
    for (uint SampleIndex = 0u; SampleIndex < SampleCount; ++SampleIndex)
    {
        float Phi = ((float)SampleIndex + 0.5f) * HalfPi;
        float3 SecondaryDirection = normalize(
            Tangent * (SinTheta * cos(Phi)) +
            Bitangent * (SinTheta * sin(Phi)) +
            Normal * CosTheta);

        float SecondaryDistance;
        uint SecondaryTriangleIndex;
        if (TraceClosestHit(
            SecondaryOrigin,
            SecondaryDirection,
            MaxTraceDistance,
            IgnoreTriangleIndex,
            SecondaryDistance,
            SecondaryTriangleIndex))
        {
            float3 SecondaryHitPosition =
                SecondaryOrigin + SecondaryDirection * SecondaryDistance;
            float3 SecondaryDirectAndEmissive = EvaluateHitSurfaceRadiance(
                SecondaryTriangleIndex,
                SecondaryHitPosition,
                SecondaryDirection);
            // Evaluate one additional diffuse bounce only. Do not recursively
            // launch another hemisphere at this secondary surface.
            IncomingRadianceSum += SecondaryDirectAndEmissive;
        }
        else if (bEnableStaticBackground != 0u)
        {
            IncomingRadianceSum +=
                StaticBackgroundColor.rgb * StaticBackgroundIntensity * GIIntensity;
        }
    }

    return IncomingRadianceSum / (float)SampleCount;
}

[numthreads(64, 1, 1)]
void RadianceCascadeTraceCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalTexels || ProbeCount == 0u || TotalRaysPerProbe == 0u)
    {
        return;
    }

    uint2 Pixel = uint2(LinearIndex % TextureWidth, LinearIndex / TextureWidth);
    float3 Origin = RayOriginsTexture.Load(int3(Pixel, 0)).xyz;
    float4 PackedDirection = DirectionsTexture.Load(int3(Pixel, 0));
    float3 Direction = normalize(PackedDirection.xyz);
    uint CascadeIndex = min((uint)max(PackedDirection.w, 0.0f), max(CascadeCount, 1u) - 1u);
    float2 CascadeInterval = DDGIRadianceCascadeDistanceInterval(
        (int)CascadeIndex, BaseSegmentLength, CascadeScale, MaxTraceDistance);
    float CascadeStartDistance = CascadeInterval.x;
    float CascadeEndDistance = CascadeInterval.y;
    // Stop BVH traversal at this interval's end; hits before the interval are
    // still detected so they can occlude farther cascades.
    float ClosestHit = CascadeEndDistance;
    bool bHit = false;
    uint ClosestTriangleIndex = 0u;

    uint Stack[64];
    float NearStack[64];
    uint StackSize = 0u;
    uint IterationCount = 0u;

    // Empty geometry has no root node to read. The root is the only node
    // whose bounds have not already been tested by its parent.
    if (NodeCount > 0u && TriangleCount > 0u)
    {
        Stack[StackSize] = 0u;
        NearStack[StackSize++] = -1.0f;
    }

    [loop]
    while (StackSize > 0u && IterationCount < NodeCount)
    {
        ++IterationCount;
        --StackSize;
        uint NodeIndex = Stack[StackSize];
        float NodeNear = NearStack[StackSize];
        if (NodeIndex >= NodeCount || (NodeNear >= 0.0f && NodeNear > ClosestHit))
        {
            continue;
        }

        uint NodeBase = NodeIndex * 3u;
        // Child bounds were tested before insertion. Reuse their saved
        // near distance and only test the root bounds on first visit.
        if (NodeNear < 0.0f && !IntersectBounds(
            Origin, Direction,
            BVHNodes[NodeBase + 0u].xyz,
            BVHNodes[NodeBase + 1u].xyz,
            ClosestHit))
        {
            continue;
        }

        float4 Metadata = BVHNodes[NodeBase + 2u];
        uint FirstTriangle = (uint)max(Metadata.z, 0.0f);
        uint LeafTriangleCount = (uint)max(Metadata.w, 0.0f);

        if (LeafTriangleCount > 0u)
        {
            [loop]
            for (uint LocalTriangle = 0u; LocalTriangle < LeafTriangleCount; ++LocalTriangle)
            {
                uint TriangleIndex = FirstTriangle + LocalTriangle;
                if (TriangleIndex >= TriangleCount)
                {
                    continue;
                }

                uint TriangleBase = TriangleIndex * 4u;
                float HitDistance;
                if (IntersectTriangle(
                    Origin, Direction,
                    BVHTriangles[TriangleBase + 0u].xyz,
                    BVHTriangles[TriangleBase + 1u].xyz,
                    BVHTriangles[TriangleBase + 2u].xyz,
                    HitDistance) && HitDistance < ClosestHit)
                {
                    ClosestHit = HitDistance;
                    ClosestTriangleIndex = TriangleIndex;
                    bHit = true;
                }
            }
        }
        else
        {
            uint LeftChild = (uint)max(Metadata.x, 0.0f);
            uint RightChild = (uint)max(Metadata.y, 0.0f);
            float LeftNear = 0.0f;
            float RightNear = 0.0f;
            bool bHitLeft = false;
            bool bHitRight = false;

            if (LeftChild < NodeCount)
            {
                uint LeftBase = LeftChild * 3u;
                bHitLeft = IntersectBoundsWithNear(
                    Origin, Direction,
                    BVHNodes[LeftBase + 0u].xyz,
                    BVHNodes[LeftBase + 1u].xyz,
                    ClosestHit, LeftNear);
            }
            if (RightChild < NodeCount)
            {
                uint RightBase = RightChild * 3u;
                bHitRight = IntersectBoundsWithNear(
                    Origin, Direction,
                    BVHNodes[RightBase + 0u].xyz,
                    BVHNodes[RightBase + 1u].xyz,
                    ClosestHit, RightNear);
            }

            // Push the farther child first; the nearer child is popped next.
            // The CPU builder caps validated tree depth at 48, so the maximum
            // pending DFS stack is below this 64-entry capacity.
            if (bHitLeft && bHitRight)
            {
                if (LeftNear <= RightNear)
                {
                    Stack[StackSize] = RightChild;
                    NearStack[StackSize++] = RightNear;
                    Stack[StackSize] = LeftChild;
                    NearStack[StackSize++] = LeftNear;
                }
                else
                {
                    Stack[StackSize] = LeftChild;
                    NearStack[StackSize++] = LeftNear;
                    Stack[StackSize] = RightChild;
                    NearStack[StackSize++] = RightNear;
                }
            }
            else if (bHitLeft)
            {
                Stack[StackSize] = LeftChild;
                NearStack[StackSize++] = LeftNear;
            }
            else if (bHitRight)
            {
                Stack[StackSize] = RightChild;
                NearStack[StackSize++] = RightNear;
            }
        }
    }

    // Cascades own disjoint ray-distance intervals. A hit before this
    // interval means an earlier surface blocks the ray; a hit beyond it
    // belongs to a farther cascade.
    bool bBlockedByEarlierSurface = bHit && ClosestHit < CascadeStartDistance;
    bool bHitInThisInterval = bHit &&
        ClosestHit >= CascadeStartDistance &&
        ClosestHit <= CascadeEndDistance;
    HitDistanceUAV[Pixel] = bHitInThisInterval || bBlockedByEarlierSurface ? ClosestHit : -1.0f;
    HitTriangleIndexUAV[Pixel] = bHitInThisInterval ? (ClosestTriangleIndex + 1u) : 0u;

    // The static environment is injected only by the farthest cascade.
    // Injecting it into every interval would count the same environment many times.
    float BackgroundFade = 0.0f;
    if (bEnableStaticBackground != 0u && CascadeIndex + 1u == CascadeCount &&
        !bHitInThisInterval && !bBlockedByEarlierSurface)
    {
        float ProbeDistance = distance(Origin, ProbeGridOrigin.xyz);
        float TransitionWidth = max(BackgroundTransitionEnd - BackgroundTransitionStart, 1.0e-3f);
        BackgroundFade = smoothstep(BackgroundTransitionStart, BackgroundTransitionStart + TransitionWidth, ProbeDistance);
    }

    float3 BackgroundRadiance = StaticBackgroundColor.rgb * StaticBackgroundIntensity * GIIntensity * BackgroundFade;
    float3 HitEmissiveRadiance = 0.0f;
    float3 HitDirectRadiance = 0.0f;
    float3 HitIndirectRadiance = 0.0f;
    if (bHitInThisInterval)
    {
        uint HitTriangleBase = ClosestTriangleIndex * 4u;
        float3 HitA = BVHTriangles[HitTriangleBase + 0u].xyz;
        float3 HitB = BVHTriangles[HitTriangleBase + 1u].xyz;
        float3 HitC = BVHTriangles[HitTriangleBase + 2u].xyz;
        float3 GeometricNormal = ComputeTriangleGeometricNormal(HitA, HitB, HitC);
        if (dot(GeometricNormal, Direction) > 0.0f)
        {
            GeometricNormal = -GeometricNormal;
        }

        float3 HitPosition = Origin + Direction * ClosestHit;
        float3 HitBaseColor = max(BVHTriangles[HitTriangleBase + 3u].xyz, 0.0f);
        HitEmissiveRadiance = float3(
            BVHTriangles[HitTriangleBase + 0u].w,
            BVHTriangles[HitTriangleBase + 1u].w,
            BVHTriangles[HitTriangleBase + 2u].w) * GIIntensity;

        // A black diffuse albedo cannot receive direct diffuse light.
        // Keep emissive radiance above, but skip the pointless shadow traversal.
        if (dot(GeometricNormal, GeometricNormal) > 0.0f &&
            bHasDirectionalLight != 0u &&
            any(HitBaseColor > 1.0e-6f))
        {
            float3 ToLight = normalize(DirectionalLightDirection.xyz);
            float NdotL = saturate(dot(GeometricNormal, ToLight));
            if (NdotL > 0.0f)
            {
                float3 ShadowOrigin = HitPosition + GeometricNormal * ComputeRayOriginBias(HitPosition);
                const float DirectionalShadowDistance = 1000000.0f;
                const bool bOccluded = TraceAnyHit(
                    ShadowOrigin, ToLight, DirectionalShadowDistance, ClosestTriangleIndex);
                if (!bOccluded)
                {
                    HitDirectRadiance = HitBaseColor * DirectionalLightColor.rgb *
                        DirectionalLightIntensity * NdotL * (1.0f / 3.14159265f) * GIIntensity;
                }
            }
        }

        // One deterministic diffuse bounce: secondary rays evaluate direct
        // and emissive radiance at the next surface, then the primary hit
        // reflects their average according to its diffuse base color.
        // A zero-albedo surface reflects no diffuse indirect light.
        // Avoid four secondary BVH rays when their contribution is guaranteed
        // to be zero after multiplication by HitBaseColor.
        if (dot(GeometricNormal, GeometricNormal) > 0.0f &&
            any(HitBaseColor > 1.0e-6f))
        {
            float3 IncomingBounceRadiance = TraceDeterministicDiffuseBounce(
                HitPosition, GeometricNormal, ClosestTriangleIndex);
            HitIndirectRadiance = HitBaseColor * IncomingBounceRadiance;
        }
    }

    RadianceUAV[Pixel] = float4(
        bHitInThisInterval
            ? (HitEmissiveRadiance + HitDirectRadiance + HitIndirectRadiance)
            : BackgroundRadiance,
        1.0f);
}

#include "/Engine/Public/Platform.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadeLayout.ush"
uint TextureWidth, TotalTexels, DispatchGroupsX, ProbeCount, TraceStartIndex, TotalRaysPerProbe, BaseRayCount, HashCapacity, TriangleCount;
float ProbeSpacing;
float BaseSegmentLength;
float CascadeScale;
float4 ProbeGridOrigin;
Texture2D<float4> RadianceTexture;
Texture2D<float> HitDistanceTexture;
Texture2D<uint> HitTriangleIndexTexture;
Texture2D<float4> DirectionsTexture;
Texture2D<float4> ProbePositionsTexture;
StructuredBuffer<float4> BVHTriangles;
StructuredBuffer<int4> ProbeSpatialHash;
StructuredBuffer<uint> ProbeNeighborIndices;
StructuredBuffer<uint> LogicalToPhysicalSlots;
uint UsePrecomputedProbeNeighbors;
RWTexture2D<float4> OutputRadianceUAV;

// Match the tracing shader's scale-aware normal calculation so gather
// filtering remains stable for very small and very large triangles.
float3 ComputeGatherTriangleNormal(float3 A, float3 B, float3 C)
{
    float3 EdgeAB = B - A;
    float3 EdgeAC = C - A;
    float EdgeScale = max(
        max(max(abs(EdgeAB.x), abs(EdgeAB.y)), abs(EdgeAB.z)),
        max(max(abs(EdgeAC.x), abs(EdgeAC.y)), abs(EdgeAC.z)));
    if (!(EdgeScale > 0.0f) || !isfinite(EdgeScale))
    {
        return 0.0f;
    }

    float3 ScaledCross = cross(EdgeAB / EdgeScale, EdgeAC / EdgeScale);
    float NormalLengthSquared = dot(ScaledCross, ScaledCross);
    if (!(NormalLengthSquared > 1.0e-12f) || !isfinite(NormalLengthSquared))
    {
        return 0.0f;
    }

    return ScaledCross * rsqrt(NormalLengthSquared);
}

uint DDGIHashProbeCell(int3 Cell, uint Level)
{
    uint Hash = asuint(Cell.x) * 0x8DA6B343u;
    Hash ^= asuint(Cell.y) * 0xD8163841u;
    Hash ^= asuint(Cell.z) * 0xCB1AB31Fu;
    Hash ^= (Level + 1u) * 0x9E3779B9u;
    Hash ^= Hash >> 16; Hash *= 0x7FEB352Du;
    Hash ^= Hash >> 15; Hash *= 0x846CA68Bu;
    Hash ^= Hash >> 16;
    return Hash;
}
bool DDGIFindProbeInCell(int3 Cell, uint Level, out uint OutProbeIndex)
{
    OutProbeIndex = 0u;
    if (HashCapacity == 0u || ProbeCount == 0u || Level > 7u) return false;
    uint Slot = DDGIHashProbeCell(Cell, Level) & (HashCapacity - 1u);
    [loop] for (uint Attempt = 0u; Attempt < HashCapacity; ++Attempt)
    {
        int4 Entry = ProbeSpatialHash[Slot];
        if (Entry.w < 0) return false;
        if (all(Entry.xyz == Cell) &&
            (((uint)Entry.w & 7u) == Level))
        {
            OutProbeIndex = (uint)Entry.w >> 3u;
            return OutProbeIndex < ProbeCount;
        }
        Slot = (Slot + 1u) & (HashCapacity - 1u);
    }
    return false;
}
[numthreads(64, 1, 1)]
void RadianceCascadeSpatialGatherCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalTexels || ProbeCount == 0u || TotalRaysPerProbe == 0u || BaseRayCount == 0u) return;
    uint ScheduledProbeIndex = LinearIndex / TotalRaysPerProbe;
    uint ProbeIndex = (TraceStartIndex + ScheduledProbeIndex) % ProbeCount;
    uint RayIndex = LinearIndex - ScheduledProbeIndex * TotalRaysPerProbe;
    uint PhysicalProbeIndex = LogicalToPhysicalSlots[ProbeIndex];
    uint PhysicalLinearIndex = PhysicalProbeIndex * TotalRaysPerProbe + RayIndex;
    uint2 Pixel = uint2(PhysicalLinearIndex % TextureWidth, PhysicalLinearIndex / TextureWidth);

    // Gather corresponding angular samples independently for every cascade.
    // ProbePositionsTexture stores BVH-local positions. Keep this coordinate
    // space for hit-plane tests; convert to world-lattice coordinates only
    // when looking up neighboring probe cells.
    // Load the probe metadata once: both position and level are needed for
    // every ray processed by this probe.
    float4 CenterProbeData = ProbePositionsTexture.Load(
        int3(ProbeIndex % TextureWidth, ProbeIndex / TextureWidth, 0));
    float3 CenterPosition = CenterProbeData.xyz;
    float3 CenterWorldLatticePosition = CenterPosition - ProbeGridOrigin.xyz;
    uint2 DirectionPixel = uint2(RayIndex % TextureWidth, RayIndex / TextureWidth);
    float4 CenterDirectionData = DirectionsTexture.Load(int3(DirectionPixel, 0));
    float3 CenterDirection = normalize(CenterDirectionData.xyz);
    uint CascadeIndex = (uint)clamp(round(CenterDirectionData.w), 0.0f, 7.0f);
    uint SafeBaseRayCount = clamp(BaseRayCount, 1u, 64u);
    uint CascadeStorageOffset = SafeBaseRayCount * ((1u << CascadeIndex) - 1u);
    uint LocalCascadeRayIndex = RayIndex - CascadeStorageOffset;
    float3 CascadeOriginOffset = 0.0f;
    [loop]
    for (uint AncestorCascade = 0u; AncestorCascade < CascadeIndex; ++AncestorCascade)
    {
        uint AncestorShift = CascadeIndex - AncestorCascade;
        uint AncestorLocalRayIndex = LocalCascadeRayIndex >> AncestorShift;
        uint AncestorStorageOffset =
            SafeBaseRayCount * ((1u << AncestorCascade) - 1u);
        uint AncestorRayIndex = AncestorStorageOffset + AncestorLocalRayIndex;
        uint2 AncestorDirectionPixel = uint2(
            AncestorRayIndex % TextureWidth,
            AncestorRayIndex / TextureWidth);
        float3 AncestorDirection = normalize(
            DirectionsTexture.Load(int3(AncestorDirectionPixel, 0)).xyz);
        float AncestorSegmentLength = DDGIRadianceCascadeSegmentLength(
            (int)AncestorCascade, BaseSegmentLength, CascadeScale);
        CascadeOriginOffset += AncestorDirection * AncestorSegmentLength;
    }
    float3 CenterRayOrigin = CenterPosition + CascadeOriginOffset;
    float4 CenterRadianceSample = RadianceTexture.Load(int3(Pixel, 0));
    float CenterHitDistance = HitDistanceTexture.Load(int3(Pixel, 0));
    bool CenterHit = CenterHitDistance >= 0.0f;
    float3 RadianceSum = CenterRadianceSample.rgb;
    float3 CenterHitPosition = CenterRayOrigin + CenterDirection * max(CenterHitDistance, 0.0f);
    uint CenterTriangleTag = HitTriangleIndexTexture.Load(int3(Pixel,0));
    bool CenterHasSurfaceTag = CenterTriangleTag > 0u;
    // A positive distance without a triangle tag means an earlier cascade
    // already blocked this ray. Preserve it; there is no local surface to gather.
    if (CenterHitDistance >= 0.0f && !CenterHasSurfaceTag)
    {
        OutputRadianceUAV[Pixel] = CenterRadianceSample;
        return;
    }
    float3 CenterNormal = 0.0f;
    float3 CenterPlanePoint = 0.0f;
    if (CenterHasSurfaceTag)
    {
        uint CenterTriangleIndex = CenterTriangleTag - 1u;
        if (CenterTriangleIndex >= TriangleCount)
        {
            OutputRadianceUAV[Pixel] = CenterRadianceSample;
            return;
        }
        uint CenterTriangleBase = CenterTriangleIndex * 4u;
        // Reuse the plane point for the normal calculation instead of issuing
        // a second structured-buffer load for triangle vertex A.
        float3 CenterTriangleA = BVHTriangles[CenterTriangleBase + 0u].xyz;
        float3 CenterTriangleB = BVHTriangles[CenterTriangleBase + 1u].xyz;
        float3 CenterTriangleC = BVHTriangles[CenterTriangleBase + 2u].xyz;
        CenterPlanePoint = CenterTriangleA;
        CenterNormal = ComputeGatherTriangleNormal(
            CenterTriangleA,
            CenterTriangleB,
            CenterTriangleC);
        if (dot(CenterNormal, CenterDirection) > 0.0f) CenterNormal = -CenterNormal;
    }
    float WeightSum = 1.0f;
    // Clipmap levels use nested power-of-two spacing: 1, 2, 4, 8.
    float CenterLevelValue = CenterProbeData.w;
    uint CenterLevel = (uint)clamp(round(CenterLevelValue), 0.0f, 3.0f);
    float LevelScale = exp2((float)CenterLevel);
    float SafeSpacing = max(ProbeSpacing, 1.0f) * LevelScale;
    float MaxHitPositionDelta = SafeSpacing * 1.25f;
    float MaxHitPositionDeltaSquared = MaxHitPositionDelta * MaxHitPositionDelta;
    float PlaneTolerance = clamp(SafeSpacing * 0.01f, 0.05f, 1.0f);
    float WeightDistanceRange = SafeSpacing * 1.75f;
    // Hash coordinates are only needed by the fallback lookup. Avoid the
    // per-ray conversion when the precomputed neighbor list is active.
    int3 CenterCell = 0;
    int3 LevelCellStep = 0;
    if (UsePrecomputedProbeNeighbors == 0u)
    {
        CenterCell = int3(round(CenterWorldLatticePosition / max(ProbeSpacing, 1.0f)));
        LevelCellStep = int3((int)LevelScale, (int)LevelScale, (int)LevelScale);
    }
    uint NeighborSlot = 0u;
    [unroll] for (int Z=-1; Z<=1; ++Z)
    [unroll] for (int Y=-1; Y<=1; ++Y)
    [unroll] for (int X=-1; X<=1; ++X)
    {
        if (X==0 && Y==0 && Z==0) continue;
        uint NeighborIndex;
        if (UsePrecomputedProbeNeighbors != 0u)
        {
            NeighborIndex = ProbeNeighborIndices[ProbeIndex * 26u + NeighborSlot];
            ++NeighborSlot;
            if (NeighborIndex == 0xFFFFFFFFu || NeighborIndex >= ProbeCount) continue;
        }
        else
        {
            int3 NeighborCell = CenterCell + int3(X,Y,Z) * LevelCellStep;
            if (!DDGIFindProbeInCell(NeighborCell, CenterLevel, NeighborIndex))
            {
                ++NeighborSlot;
                continue;
            }
            ++NeighborSlot;
        }
        // Neighbor radiance is persistent by design: incremental probe updates
        // rely on the last completed sample for probes outside this frame's batch.
        // Rejecting those samples would collapse gather support to the current
        // scheduling slice and create visible spatial discontinuities.

        // Read the actual neighbor offset instead of reconstructing its position
        // from a global spacing. This is equivalent for the current uniform
        // lattice and remains correct when probes later use per-level spacing.
        float3 NeighborPosition = ProbePositionsTexture.Load(
            int3(NeighborIndex % TextureWidth, NeighborIndex / TextureWidth, 0)).xyz;
        uint NeighborPhysicalIndex = LogicalToPhysicalSlots[NeighborIndex];
        uint NeighborLinear = NeighborPhysicalIndex * TotalRaysPerProbe + RayIndex;
        uint2 NeighborPixel = uint2(NeighborLinear % TextureWidth, NeighborLinear / TextureWidth);
        // Ray directions are initialized solely from RayIndex and cascade
        // layout, so every probe stores the exact same direction for this ray.
        // No per-neighbor direction texture fetch or normalization is needed.
        float NeighborHitDistance = HitDistanceTexture.Load(int3(NeighborPixel,0));
        bool NeighborHit = NeighborHitDistance >= 0.0f;
        if (CenterHit != NeighborHit) continue;
        // Hit distances are measured from different probe origins. Their values
        // can differ by nearly one probe spacing even when both rays hit the
        // same plane; compare reconstructed world hit positions below instead.
        uint NeighborTriangleTag = HitTriangleIndexTexture.Load(int3(NeighborPixel,0));
        bool NeighborHasSurfaceTag = NeighborTriangleTag > 0u;
        if (CenterHasSurfaceTag != NeighborHasSurfaceTag) continue;
        if (CenterHit)
        {
            // Every ray belonging to this probe shares its probe position as origin.
            float3 NeighborRayOrigin = NeighborPosition + CascadeOriginOffset;
            float3 NeighborHitPosition = NeighborRayOrigin + CenterDirection * NeighborHitDistance;
            float3 HitPositionDelta = CenterHitPosition - NeighborHitPosition;
            // Compare squared distances: the square root from distance() is
            // unnecessary because this branch only tests against a threshold.
            if (dot(HitPositionDelta, HitPositionDelta) >
                MaxHitPositionDeltaSquared) continue;
            uint NeighborTriangleIndex = NeighborTriangleTag - 1u;
            if (NeighborTriangleIndex >= TriangleCount) continue;
            uint NeighborTriangleBase = NeighborTriangleIndex * 4u;
            float3 NeighborPlanePoint = BVHTriangles[NeighborTriangleBase + 0u].xyz;
            float3 NeighborNormal = ComputeGatherTriangleNormal(
                NeighborPlanePoint,
                BVHTriangles[NeighborTriangleBase + 1u].xyz,
                BVHTriangles[NeighborTriangleBase + 2u].xyz);
            if (dot(NeighborNormal, CenterDirection) > 0.0f) NeighborNormal = -NeighborNormal;
            if (dot(CenterNormal, NeighborNormal) < 0.85f) continue;

            // Require both hit points to lie close to the opposite triangle
            // plane. This rejects nearby parallel surfaces while still allowing
            // different coplanar triangles to contribute to the same gather.
            // Keep the tolerance bounded in world units so large probe spacing
            // cannot make distinct walls appear coplanar.
            float CenterToNeighborPlane = abs(dot(CenterHitPosition - NeighborPlanePoint, NeighborNormal));
            float NeighborToCenterPlane = abs(dot(NeighborHitPosition - CenterPlanePoint, CenterNormal));
            if (CenterToNeighborPlane > PlaneTolerance ||
                NeighborToCenterPlane > PlaneTolerance) continue;
        }
        float Weight = saturate(1.0f - distance(CenterPosition, NeighborPosition) / WeightDistanceRange);
        if (Weight <= 0.0f) continue;
        // Fetch radiance only after the neighbor passes all hit, surface,
        // normal, plane, and distance filters.
        float4 NeighborRadianceSample = RadianceTexture.Load(int3(NeighborPixel,0));
        RadianceSum += NeighborRadianceSample.rgb * Weight;
        WeightSum += Weight;
    }
    OutputRadianceUAV[Pixel] = float4(RadianceSum / max(WeightSum,1.0e-5f),1.0f);
}

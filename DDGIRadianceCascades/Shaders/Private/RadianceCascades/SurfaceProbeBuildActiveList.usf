#include "/Engine/Public/Platform.ush"

StructuredBuffer<uint> SurfaceProbeLastSeenFrames;
RWStructuredBuffer<uint> SurfaceProbeActiveIndices;
RWStructuredBuffer<uint> SurfaceProbeTraceIndices;
RWStructuredBuffer<uint> SurfaceProbeCounters;

uint ProbeCapacity;
uint FrameNumber;
uint TraceProbeBudget;

static const uint DDGI_SURFACE_PROBE_RETENTION_FRAMES = 120u;

// Keep the active list sorted by physical slot. The trace scheduler uses this
// stable ordering for starvation-free round robin across frames.
[numthreads(1, 1, 1)]
void SurfaceProbeBuildActiveListCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint AllocatedCount = min(SurfaceProbeCounters[4], ProbeCapacity);
    uint ActiveCount = 0u;
    SurfaceProbeCounters[6] = 0u;

    [loop]
    for (uint PhysicalSlot = 0u; PhysicalSlot < AllocatedCount; ++PhysicalSlot)
    {
        uint LastSeenFrame = SurfaceProbeLastSeenFrames[PhysicalSlot];
        uint FrameAge = FrameNumber - LastSeenFrame;
        if (FrameAge <= DDGI_SURFACE_PROBE_RETENTION_FRAMES)
        {
            SurfaceProbeActiveIndices[ActiveCount] = PhysicalSlot;
            ++ActiveCount;
        }
    }

    SurfaceProbeCounters[6] = ActiveCount;
}

[numthreads(1, 1, 1)]
void SurfaceProbeScheduleTraceCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint ActiveCount = min(SurfaceProbeCounters[6], ProbeCapacity);
    uint TraceBudget = min(TraceProbeBudget, ActiveCount);
    uint Cursor = ActiveCount > 0u ? (SurfaceProbeCounters[8] % ActiveCount) : 0u;

    SurfaceProbeCounters[7] = 0u;
    if (ActiveCount == 0u || TraceBudget == 0u)
    {
        SurfaceProbeCounters[8] = 0u;
        return;
    }

    [loop]
    for (uint Scheduled = 0u; Scheduled < TraceBudget; ++Scheduled)
    {
        uint ActiveListIndex = (Cursor + Scheduled) % ActiveCount;
        SurfaceProbeTraceIndices[Scheduled] = SurfaceProbeActiveIndices[ActiveListIndex];
    }

    SurfaceProbeCounters[7] = TraceBudget;
    SurfaceProbeCounters[8] = (Cursor + TraceBudget) % ActiveCount;
}

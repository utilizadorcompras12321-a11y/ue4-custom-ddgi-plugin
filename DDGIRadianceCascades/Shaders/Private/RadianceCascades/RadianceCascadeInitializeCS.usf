#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadeLayout.ush"

uint TotalRaysPerProbe;
uint CascadeCount;
uint BaseRayCount;
uint RaySplitFactor;
uint TextureWidth;
uint TotalTexels;
uint DispatchGroupsX;
uint ProbeCount;
Texture2D<float4> ProbePositionsTexture;

RWTexture2D<float4> DirectionsUAV;
RWTexture2D<float4> RadianceUAV;
RWTexture2D<float> HitDistanceUAV;
RWTexture2D<float4> RayOriginsUAV;

float3 DDGIRadianceCascadeBaseDirection(uint RayIndex, uint RayCount)
{
    const float GoldenAngle = 2.39996322972865332f;
    float Y = 1.0f - 2.0f * ((float)RayIndex + 0.5f) / (float)max(RayCount, 1u);
    float Radius = sqrt(saturate(1.0f - Y * Y));
    float Angle = (float)RayIndex * GoldenAngle;
    return normalize(float3(cos(Angle) * Radius, Y, sin(Angle) * Radius));
}

[numthreads(64, 1, 1)]
void RadianceCascadeInitializeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalTexels || TotalRaysPerProbe == 0u || ProbeCount == 0u)
    {
        return;
    }

    uint ProbeIndex = LinearIndex / TotalRaysPerProbe;
    uint2 ProbePixel = uint2(ProbeIndex % TextureWidth, ProbeIndex / TextureWidth);
    float4 ProbeOrigin = ProbePositionsTexture.Load(int3(ProbePixel, 0));
    uint PackedRayIndex = LinearIndex % TotalRaysPerProbe;
    uint CascadeIndex = 0u;
    uint CascadeOffset = 0u;
    uint CascadeRayCount = BaseRayCount;

    [loop]
    for (uint Cascade = 0u; Cascade < CascadeCount; ++Cascade)
    {
        if (PackedRayIndex < CascadeOffset + CascadeRayCount)
        {
            CascadeIndex = Cascade;
            break;
        }
        CascadeOffset += CascadeRayCount;
        CascadeRayCount = min(CascadeRayCount * RaySplitFactor, 65536u);
    }

    uint RayIndex = PackedRayIndex - CascadeOffset;
    uint BaseRayIndex = RayIndex;
    [loop]
    for (uint ParentLevel = CascadeIndex; ParentLevel > 0u; --ParentLevel)
    {
        uint ParentRayCount = DDGIRadianceCascadeRayCount(
            ParentLevel - 1u, BaseRayCount, RaySplitFactor);
        uint ChildRayCount = DDGIRadianceCascadeRayCount(
            ParentLevel, BaseRayCount, RaySplitFactor);
        uint EffectiveSplit = max(1u, ChildRayCount / max(ParentRayCount, 1u));
        BaseRayIndex /= EffectiveSplit;
    }

    float3 Direction = DDGIRadianceCascadeBaseDirection(BaseRayIndex, BaseRayCount);

    [loop]
    for (uint Level = 1u; Level <= CascadeIndex; ++Level)
    {
        uint ChildIndexAtLevel = RayIndex;
        [loop]
        for (uint DescendantLevel = CascadeIndex; DescendantLevel > Level; --DescendantLevel)
        {
            uint ParentRayCount = DDGIRadianceCascadeRayCount(
                DescendantLevel - 1u, BaseRayCount, RaySplitFactor);
            uint ChildRayCount = DDGIRadianceCascadeRayCount(
                DescendantLevel, BaseRayCount, RaySplitFactor);
            uint DescendantSplit = max(1u, ChildRayCount / max(ParentRayCount, 1u));
            ChildIndexAtLevel /= DescendantSplit;
        }

        uint ParentRayCount = DDGIRadianceCascadeRayCount(
            Level - 1u, BaseRayCount, RaySplitFactor);
        uint ChildRayCount = DDGIRadianceCascadeRayCount(
            Level, BaseRayCount, RaySplitFactor);
        uint EffectiveSplit = max(1u, ChildRayCount / max(ParentRayCount, 1u));
        uint ParentIndexAtLevel = ChildIndexAtLevel / EffectiveSplit;
        float ParentConeHalfAngle = acos(clamp(
            1.0f - 2.0f / (float)max(ParentRayCount, 1u), -1.0f, 1.0f));
        if (EffectiveSplit > 1u)
        {
            Direction = DDGIRadianceCascadeChildRayDirection(
                Direction, ChildIndexAtLevel, EffectiveSplit,
                ParentConeHalfAngle, ParentIndexAtLevel);
        }
    }

    uint2 Pixel = uint2(LinearIndex % TextureWidth, LinearIndex / TextureWidth);
    DirectionsUAV[Pixel] = float4(Direction, (float)CascadeIndex);
    RadianceUAV[Pixel] = 0.0f;
    HitDistanceUAV[Pixel] = -1.0f;
    RayOriginsUAV[Pixel] = ProbeOrigin;
}

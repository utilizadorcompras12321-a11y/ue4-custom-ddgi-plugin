#include "/Engine/Public/Platform.ush"
#include "/Plugin/DDGIRadianceCascades/Private/RadianceCascades/RadianceCascadeLayout.ush"

uint TotalRaysPerProbe;
uint CascadeCount;
uint BaseRayCount;
uint TextureWidth;
uint TotalTexels;
uint DispatchGroupsX;
uint ProbeCount;

RWTexture2D<float4> DirectionsUAV;
RWTexture2D<float4> RadianceUAV;
RWTexture2D<float> HitDistanceUAV;
RWTexture2D<float4> RadianceScratchUAV;
RWTexture2D<uint> RadianceIntegrationScratchUAV;
RWTexture2D<uint> HitTriangleIndexUAV;
StructuredBuffer<uint> NewPhysicalSlots;
uint bInitializeDirections;


[numthreads(64, 1, 1)]
void RadianceCascadeInitializeCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalTexels || TotalRaysPerProbe == 0u || ProbeCount == 0u)
    {
        return;
    }

    uint ProbeIndex = LinearIndex / TotalRaysPerProbe;
    uint PackedRayIndex = LinearIndex - ProbeIndex * TotalRaysPerProbe;
    uint PhysicalProbeIndex = NewPhysicalSlots[ProbeIndex];
    uint PhysicalLinearIndex = PhysicalProbeIndex * TotalRaysPerProbe + PackedRayIndex;
    uint2 Pixel = uint2(PhysicalLinearIndex % TextureWidth, PhysicalLinearIndex / TextureWidth);

    // Angular regions are identical for every probe. Only probe zero needs
    // to calculate and populate the shared direction table; all probes still
    // initialize their own per-ray history textures.
    if (bInitializeDirections == 0u || ProbeIndex != 0u)
    {
        RadianceUAV[Pixel] = 0.0f;
        HitDistanceUAV[Pixel] = -1.0f;
        RadianceScratchUAV[Pixel] = 0.0f;
        RadianceIntegrationScratchUAV[Pixel] = 0u;
        HitTriangleIndexUAV[Pixel] = 0u;
        return;
    }

    // No angular splitting: all distance cascades reuse the same
    // equal-solid-angle directions. Only the distance interval changes.
    uint SafeBaseRayCount = clamp(BaseRayCount, 1u, 64u);
    uint CascadeIndex = min(PackedRayIndex / SafeBaseRayCount, CascadeCount - 1u);
    uint RayIndex = PackedRayIndex - CascadeIndex * SafeBaseRayCount;
    float4 AngularRegion = DDGIRadianceCascadeBaseRegion(RayIndex, SafeBaseRayCount);
    float3 Direction = DDGIRadianceCascadeRegionDirection(AngularRegion);

    uint2 DirectionPixel = uint2(PackedRayIndex % TextureWidth, PackedRayIndex / TextureWidth);
    DirectionsUAV[DirectionPixel] = float4(Direction, (float)CascadeIndex);
    RadianceUAV[Pixel] = 0.0f;
    HitDistanceUAV[Pixel] = -1.0f;
    RadianceScratchUAV[Pixel] = 0.0f;
    RadianceIntegrationScratchUAV[Pixel] = 0u;
    HitTriangleIndexUAV[Pixel] = 0u;
}

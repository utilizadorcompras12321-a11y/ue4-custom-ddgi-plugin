#ifndef DDGI_RADIANCE_CASCADE_LAYOUT_USH
#define DDGI_RADIANCE_CASCADE_LAYOUT_USH

// Mirrors FDDGIRadianceCascadeConfig. Cascade intervals are disjoint;
// cascade N covers only [start(N), end(N)] and never re-integrates earlier ranges.

float DDGIRadianceCascadeSegmentLength(
	int CascadeIndex,
	float BaseSegmentLength,
	float CascadeScale)
{
	return max(BaseSegmentLength, 1.0) *
		pow(max(CascadeScale, 1.01), (float)max(CascadeIndex, 0));
}

float DDGIRadianceCascadeStartDistance(
	int CascadeIndex,
	float BaseSegmentLength,
	float CascadeScale)
{
	float StartDistance = 0.0;
	[loop]
	for (int Index = 0; Index < CascadeIndex; ++Index)
	{
		StartDistance += DDGIRadianceCascadeSegmentLength(
			Index, BaseSegmentLength, CascadeScale);
	}
	return StartDistance;
}

float2 DDGIRadianceCascadeDistanceInterval(
	int CascadeIndex,
	float BaseSegmentLength,
	float CascadeScale,
	float MaxTraceDistance)
{
	float StartDistance = DDGIRadianceCascadeStartDistance(
		CascadeIndex, BaseSegmentLength, CascadeScale);
	float EndDistance = StartDistance +
		DDGIRadianceCascadeSegmentLength(
			CascadeIndex, BaseSegmentLength, CascadeScale);
	return float2(min(StartDistance, MaxTraceDistance),
		min(EndDistance, MaxTraceDistance));
}

uint DDGIRadianceCascadeRayCount(
	uint CascadeIndex,
	uint BaseRayCount,
	uint RaySplitFactor)
{
	uint Count = clamp(BaseRayCount, 1u, 64u);
	uint Split = clamp(RaySplitFactor, 1u, 4u);
	[loop]
	for (uint Index = 0u; Index < CascadeIndex; ++Index)
	{
		Count = min(Count * Split, 65536u);
	}
	return Count;
}

// Rays are packed cascade-by-cascade for each probe.
uint DDGIRadianceCascadeRayStorageOffset(
	uint CascadeIndex,
	uint BaseRayCount,
	uint RaySplitFactor)
{
	uint Offset = 0u;
	[loop]
	for (uint Index = 0u; Index < CascadeIndex; ++Index)
	{
		Offset += DDGIRadianceCascadeRayCount(
			Index, BaseRayCount, RaySplitFactor);
	}
	return Offset;
}

uint DDGIRadianceCascadeRayStorageIndex(
	uint CascadeIndex,
	uint RayIndex,
	uint BaseRayCount,
	uint RaySplitFactor)
{
	uint Count = DDGIRadianceCascadeRayCount(
		CascadeIndex, BaseRayCount, RaySplitFactor);
	return DDGIRadianceCascadeRayStorageOffset(
		CascadeIndex, BaseRayCount, RaySplitFactor) +
		min(RayIndex, Count - 1u);
}

// Child rays are stored contiguously per parent. This returns the parent
// direction group for a child-ray index.
uint DDGIRadianceCascadeParentRayIndex(
	uint ChildRayIndex,
	uint RaySplitFactor)
{
	return ChildRayIndex / max(RaySplitFactor, 1u);
}

// Deterministically distributes the children inside the angular footprint
// of their parent. ParentConeHalfAngleRadians must describe the parent ray's
// angular coverage; the caller derives it from the base direction set.
float3 DDGIRadianceCascadeChildRayDirection(
	float3 ParentDirection,
	uint ChildRayIndex,
	uint RaySplitFactor,
	float ParentConeHalfAngleRadians,
	uint ParentRayIndex)
{
	uint SafeSplit = clamp(RaySplitFactor, 1u, 4u);
	uint ChildInGroup = ChildRayIndex % SafeSplit;

	float3 Axis = normalize(ParentDirection);
	float3 ReferenceUp = (abs(Axis.z) < 0.999f)
		? float3(0.0f, 0.0f, 1.0f)
		: float3(0.0f, 1.0f, 0.0f);
	float3 Tangent = normalize(cross(ReferenceUp, Axis));
	float3 Bitangent = normalize(cross(Axis, Tangent));

	const float GoldenAngle = 2.39996322972865332f;
	float ParentRotation = frac(
		sin((float)ParentRayIndex * 12.9898f + 78.233f) * 43758.5453f);
	float Azimuth = 6.283185307179586f *
		frac(ParentRotation + (float)ChildInGroup * (GoldenAngle / 6.283185307179586f));

	float RadialSample = sqrt(((float)ChildInGroup + 0.5f) / (float)SafeSplit);
	float MaxConeAngle = clamp(ParentConeHalfAngleRadians, 0.0f, 1.57079632679f);
	float CosTheta = lerp(1.0f, cos(MaxConeAngle), RadialSample);
	float SinTheta = sqrt(saturate(1.0f - CosTheta * CosTheta));

	float3 RadialDirection =
		Tangent * cos(Azimuth) +
		Bitangent * sin(Azimuth);

	return normalize(Axis * CosTheta + RadialDirection * SinTheta);
}

#endif // DDGI_RADIANCE_CASCADE_LAYOUT_USH

// Packed unsigned R11G11B10 float radiance stored in an R32_UINT texture.
// R32_UINT typed UAV loads are mandatory on D3D11.0 SM5 hardware. The three
// channels have independent exponents, avoiding shared-exponent colour loss.

uint DDGIPackUnsignedFloat(float Value, uint MantissaBits)
{
    if (Value <= 0.0f)
    {
        return 0u;
    }

    const uint MantissaMask = (1u << MantissaBits) - 1u;
    const float MantissaScale = (float)(1u << MantissaBits);
    const float MinNormal = exp2(-14.0f);
    const float MaxFinite = (2.0f - 1.0f / MantissaScale) * exp2(15.0f);

    if (Value >= MaxFinite)
    {
        return (30u << MantissaBits) | MantissaMask;
    }

    if (Value < MinNormal)
    {
        uint SubnormalMantissa = (uint)floor(
            Value / (MinNormal / MantissaScale) + 0.5f);
        return min(SubnormalMantissa, MantissaMask);
    }

    float UnbiasedExponent = floor(log2(Value));
    int BiasedExponent = (int)UnbiasedExponent + 15;
    float NormalizedMantissa = Value * exp2(-UnbiasedExponent) - 1.0f;
    uint Mantissa = (uint)floor(
        NormalizedMantissa * MantissaScale + 0.5f);

    if (Mantissa > MantissaMask)
    {
        Mantissa = 0u;
        ++BiasedExponent;
    }

    if (BiasedExponent >= 31)
    {
        return (30u << MantissaBits) | MantissaMask;
    }

    return ((uint)max(BiasedExponent, 1) << MantissaBits) | Mantissa;
}

float DDGIUnpackUnsignedFloat(uint PackedValue, uint MantissaBits)
{
    const uint MantissaMask = (1u << MantissaBits) - 1u;
    const uint Exponent = PackedValue >> MantissaBits;
    const uint Mantissa = PackedValue & MantissaMask;
    const float MantissaScale = (float)(1u << MantissaBits);

    if (Exponent == 0u)
    {
        return (float)Mantissa * exp2(-14.0f) / MantissaScale;
    }

    return (1.0f + (float)Mantissa / MantissaScale) *
        exp2((float)Exponent - 15.0f);
}

uint DDGIPackR11G11B10(float3 Radiance)
{
    float3 SafeRadiance = max(Radiance, 0.0f);
    uint R = DDGIPackUnsignedFloat(SafeRadiance.r, 6u);
    uint G = DDGIPackUnsignedFloat(SafeRadiance.g, 6u);
    uint B = DDGIPackUnsignedFloat(SafeRadiance.b, 5u);
    return R | (G << 11u) | (B << 22u);
}

float3 DDGIUnpackR11G11B10(uint PackedRadiance)
{
    uint R = PackedRadiance & 0x7ffu;
    uint G = (PackedRadiance >> 11u) & 0x7ffu;
    uint B = (PackedRadiance >> 22u) & 0x3ffu;
    return float3(
        DDGIUnpackUnsignedFloat(R, 6u),
        DDGIUnpackUnsignedFloat(G, 6u),
        DDGIUnpackUnsignedFloat(B, 5u));
}

#include "/Engine/Public/Platform.ush"

StructuredBuffer<float4> SurfaceProbePositions;
StructuredBuffer<uint> SurfaceProbeLastSeenFrames;
StructuredBuffer<uint> SurfaceProbeCounters;
RWStructuredBuffer<uint4> SurfaceProbeSpatialHash;

uint ProbeCapacity;
uint HashCapacity;
uint FrameNumber;
float CellSize;
float4 BVHWorldOrigin;

static const uint DDGI_SURFACE_SPATIAL_HASH_LOCKED = 0xffffffffu;
static const uint DDGI_SURFACE_PROBE_RETENTION_FRAMES = 120u;

uint DDGIHashSurfaceSpatialCell(int3 Cell)
{
    uint Hash = asuint(Cell.x) * 0x8DA6B343u;
    Hash ^= asuint(Cell.y) * 0xD8163841u;
    Hash ^= asuint(Cell.z) * 0xCB1AB31Fu;
    Hash ^= Hash >> 16u;
    Hash *= 0x7FEB352Du;
    Hash ^= Hash >> 15u;
    Hash *= 0x846CA68Bu;
    Hash ^= Hash >> 16u;
    return Hash;
}

[numthreads(64, 1, 1)]
void SurfaceProbeSpatialHashResetCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint Bucket = DispatchThreadID.x;
    if (Bucket < HashCapacity)
    {
        SurfaceProbeSpatialHash[Bucket] = 0u;
    }
}

[numthreads(64, 1, 1)]
void SurfaceProbeSpatialHashBuildCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint PhysicalSlot = DispatchThreadID.x;
    uint AllocatedCount = min(SurfaceProbeCounters[4], ProbeCapacity);
    if (PhysicalSlot >= AllocatedCount)
    {
        return;
    }

    uint FrameAge = FrameNumber - SurfaceProbeLastSeenFrames[PhysicalSlot];
    if (FrameAge > DDGI_SURFACE_PROBE_RETENTION_FRAMES)
    {
        return;
    }

    float4 PackedPosition = SurfaceProbePositions[PhysicalSlot];
    if (PackedPosition.w <= 0.5f)
    {
        return;
    }

    float SafeCellSize = max(CellSize, 1.0f);
    float3 LocalPosition = PackedPosition.xyz - BVHWorldOrigin.xyz;
    int3 Cell = int3(floor(LocalPosition / SafeCellSize));
    uint3 CellBits = asuint(Cell);
    uint StartBucket = DDGIHashSurfaceSpatialCell(Cell) & (HashCapacity - 1u);

    // Keep every probe in a cell, including probes on different surfaces.
    // The apply shader walks the short linear-probing cluster and filters by
    // receiver/probe normal and surface side before accepting a sample.
    [loop]
    for (uint Attempt = 0u; Attempt < HashCapacity; ++Attempt)
    {
        uint Bucket = (StartBucket + Attempt) & (HashCapacity - 1u);
        uint ExistingSlot = SurfaceProbeSpatialHash[Bucket].w;
        if (ExistingSlot == DDGI_SURFACE_SPATIAL_HASH_LOCKED)
        {
            // Skip the bucket currently being published. Its owner completes
            // the slot before the build pass ends, and this insertion continues
            // into the same linear-probing cluster instead of dropping a probe.
            continue;
        }

        if (ExistingSlot == 0u)
        {
            uint OriginalSlot;
            InterlockedCompareExchange(
                SurfaceProbeSpatialHash[Bucket].w,
                0u,
                DDGI_SURFACE_SPATIAL_HASH_LOCKED,
                OriginalSlot);
            if (OriginalSlot == 0u)
            {
                SurfaceProbeSpatialHash[Bucket].xyz = CellBits;
                DeviceMemoryBarrier();
                SurfaceProbeSpatialHash[Bucket].w = PhysicalSlot + 1u;
                return;
            }
        }
    }
}
RWStructuredBuffer<uint> SurfaceProbeFallbackCounters;
uint CounterCount;

[numthreads(64, 1, 1)]
void SurfaceProbeFallbackCounterResetCS(uint3 DispatchThreadID : SV_DispatchThreadID)
{
    uint CounterIndex = DispatchThreadID.x;
    if (CounterIndex < CounterCount)
    {
        SurfaceProbeFallbackCounters[CounterIndex] = 0u;
    }
}

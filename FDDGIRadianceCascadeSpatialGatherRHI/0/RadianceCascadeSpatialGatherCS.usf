uint TextureWidth, TotalTexels, DispatchGroupsX, ProbeCount, TotalRaysPerProbe, HashCapacity, TriangleCount;
float ProbeSpacing;
float4 ProbeGridOrigin;
Texture2D<float4> RadianceTexture;
Texture2D<float> HitDistanceTexture;
Texture2D<uint> HitTriangleIndexTexture;
Texture2D<float4> DirectionsTexture;
Texture2D<float4> ProbePositionsTexture;
StructuredBuffer<float4> BVHTriangles;
StructuredBuffer<float4> ProbeSpatialHash;
StructuredBuffer<uint> ProbeNeighborIndices;
uint UsePrecomputedProbeNeighbors;
RWTexture2D<float4> OutputRadianceUAV;



float3 ComputeGatherTriangleNormal(float3 A, float3 B, float3 C)
{
    float3 EdgeAB = B - A;
    float3 EdgeAC = C - A;
    float EdgeScale = max(
        max(max(abs(EdgeAB.x), abs(EdgeAB.y)), abs(EdgeAB.z)),
        max(max(abs(EdgeAC.x), abs(EdgeAC.y)), abs(EdgeAC.z)));
    if (!(EdgeScale > 0.0f) || !isfinite(EdgeScale))
    {
        return 0.0f;
    }

    float3 ScaledCross = cross(EdgeAB / EdgeScale, EdgeAC / EdgeScale);
    float NormalLengthSquared = dot(ScaledCross, ScaledCross);
    if (!(NormalLengthSquared > 1.0e-12f) || !isfinite(NormalLengthSquared))
    {
        return 0.0f;
    }

    return ScaledCross * rsqrt(NormalLengthSquared);
}

uint DDGIHashProbeCell(int3 Cell)
{
    uint Hash = asuint(Cell.x) * 0x8DA6B343u;
    Hash ^= asuint(Cell.y) * 0xD8163841u;
    Hash ^= asuint(Cell.z) * 0xCB1AB31Fu;
    Hash ^= Hash >> 16; Hash *= 0x7FEB352Du;
    Hash ^= Hash >> 15; Hash *= 0x846CA68Bu;
    Hash ^= Hash >> 16;
    return Hash;
}
bool DDGIFindProbeInCell(int3 Cell, out uint OutProbeIndex)
{
    OutProbeIndex = 0u;
    if (HashCapacity == 0u || ProbeCount == 0u) return false;
    uint Slot = DDGIHashProbeCell(Cell) & (HashCapacity - 1u);


    [loop] for (uint Attempt = 0u; Attempt < ProbeCount; ++Attempt)
    {
        float4 Entry = ProbeSpatialHash[Slot];
        if (Entry.w < 0.0f) return false;
        if (all(Entry.xyz == float3(Cell)))
        {
            OutProbeIndex = (uint)Entry.w;
            return OutProbeIndex < ProbeCount;
        }
        Slot = (Slot + 1u) & (HashCapacity - 1u);
    }
    return false;
}
[numthreads(64, 1, 1)]
void RadianceCascadeSpatialGatherCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
    uint LinearIndex = DispatchThreadId.x + DispatchThreadId.y * DispatchGroupsX * 64u;
    if (LinearIndex >= TotalTexels || ProbeCount == 0u || TotalRaysPerProbe == 0u) return;
    uint ProbeIndex = LinearIndex / TotalRaysPerProbe;
    uint RayIndex = LinearIndex - ProbeIndex * TotalRaysPerProbe;
    uint2 Pixel = uint2(LinearIndex % TextureWidth, LinearIndex / TextureWidth);



    float3 CenterPositionOffset = ProbePositionsTexture.Load(int3(ProbeIndex % TextureWidth, ProbeIndex / TextureWidth, 0)).xyz;
    float3 CenterPosition = ProbeGridOrigin.xyz + CenterPositionOffset;
    float3 CenterDirection = normalize(DirectionsTexture.Load(int3(Pixel, 0)).xyz);
    float4 CenterRadianceSample = RadianceTexture.Load(int3(Pixel, 0));
    float CenterHitDistance = HitDistanceTexture.Load(int3(Pixel, 0));
    bool CenterHit = CenterHitDistance >= 0.0f;
    float3 RadianceSum = CenterRadianceSample.rgb;

    float3 CenterHitPosition = CenterPosition + CenterDirection * max(CenterHitDistance, 0.0f);
    uint CenterTriangleTag = HitTriangleIndexTexture.Load(int3(Pixel,0));
    bool CenterHasSurfaceTag = CenterTriangleTag > 0u;


    if (CenterHitDistance >= 0.0f && !CenterHasSurfaceTag)
    {
        OutputRadianceUAV[Pixel] = CenterRadianceSample;
        return;
    }
    float3 CenterNormal = 0.0f;
    float3 CenterPlanePoint = 0.0f;
    if (CenterHasSurfaceTag)
    {
        uint CenterTriangleIndex = CenterTriangleTag - 1u;
        if (CenterTriangleIndex >= TriangleCount)
        {
            OutputRadianceUAV[Pixel] = CenterRadianceSample;
            return;
        }
        uint CenterTriangleBase = CenterTriangleIndex * 4u;


        float3 CenterTriangleA = BVHTriangles[CenterTriangleBase + 0u].xyz;
        float3 CenterTriangleB = BVHTriangles[CenterTriangleBase + 1u].xyz;
        float3 CenterTriangleC = BVHTriangles[CenterTriangleBase + 2u].xyz;
        CenterPlanePoint = CenterTriangleA;
        CenterNormal = ComputeGatherTriangleNormal(
            CenterTriangleA,
            CenterTriangleB,
            CenterTriangleC);
        if (dot(CenterNormal, CenterDirection) > 0.0f) CenterNormal = -CenterNormal;
    }
    float WeightSum = 1.0f;
    float SafeSpacing = max(ProbeSpacing, 1.0f);
    float MaxHitPositionDelta = SafeSpacing * 1.25f;
    float MaxHitPositionDeltaSquared = MaxHitPositionDelta * MaxHitPositionDelta;
    float PlaneTolerance = clamp(SafeSpacing * 0.01f, 0.05f, 1.0f);
    float WeightDistanceRange = SafeSpacing * 1.75f;


    int3 CenterCell = int3(round(CenterPositionOffset / SafeSpacing));
    uint NeighborSlot = 0u;
    [unroll] for (int Z=-1; Z<=1; ++Z)
    [unroll] for (int Y=-1; Y<=1; ++Y)
    [unroll] for (int X=-1; X<=1; ++X)
    {
        if (X==0 && Y==0 && Z==0) continue;
        int3 NeighborCell = CenterCell + int3(X,Y,Z);
        uint NeighborIndex;
        if (UsePrecomputedProbeNeighbors != 0u)
        {
            NeighborIndex = ProbeNeighborIndices[ProbeIndex * 26u + NeighborSlot];
            ++NeighborSlot;
            if (NeighborIndex == 0xFFFFFFFFu || NeighborIndex >= ProbeCount) continue;
        }
        else
        {
            if (!DDGIFindProbeInCell(NeighborCell, NeighborIndex))
            {
                ++NeighborSlot;
                continue;
            }
            ++NeighborSlot;
        }


        float3 NeighborPosition = ProbeGridOrigin.xyz + float3(NeighborCell) * SafeSpacing;
        uint NeighborLinear = NeighborIndex * TotalRaysPerProbe + RayIndex;
        uint2 NeighborPixel = uint2(NeighborLinear % TextureWidth, NeighborLinear / TextureWidth);



        float NeighborHitDistance = HitDistanceTexture.Load(int3(NeighborPixel,0));
        bool NeighborHit = NeighborHitDistance >= 0.0f;
        if (CenterHit != NeighborHit) continue;



        uint NeighborTriangleTag = HitTriangleIndexTexture.Load(int3(NeighborPixel,0));
        bool NeighborHasSurfaceTag = NeighborTriangleTag > 0u;
        if (CenterHasSurfaceTag != NeighborHasSurfaceTag) continue;
        if (CenterHit)
        {

            float3 NeighborHitPosition = NeighborPosition + CenterDirection * NeighborHitDistance;
            float3 HitPositionDelta = CenterHitPosition - NeighborHitPosition;


            if (dot(HitPositionDelta, HitPositionDelta) >
                MaxHitPositionDeltaSquared) continue;
            uint NeighborTriangleIndex = NeighborTriangleTag - 1u;
            if (NeighborTriangleIndex >= TriangleCount) continue;
            uint NeighborTriangleBase = NeighborTriangleIndex * 4u;
            float3 NeighborPlanePoint = BVHTriangles[NeighborTriangleBase + 0u].xyz;
            float3 NeighborNormal = ComputeGatherTriangleNormal(
                NeighborPlanePoint,
                BVHTriangles[NeighborTriangleBase + 1u].xyz,
                BVHTriangles[NeighborTriangleBase + 2u].xyz);
            if (dot(NeighborNormal, CenterDirection) > 0.0f) NeighborNormal = -NeighborNormal;
            if (dot(CenterNormal, NeighborNormal) < 0.85f) continue;






            float CenterToNeighborPlane = abs(dot(CenterHitPosition - NeighborPlanePoint, NeighborNormal));
            float NeighborToCenterPlane = abs(dot(NeighborHitPosition - CenterPlanePoint, CenterNormal));
            if (CenterToNeighborPlane > PlaneTolerance ||
                NeighborToCenterPlane > PlaneTolerance) continue;
        }
        float Weight = saturate(1.0f - distance(CenterPosition, NeighborPosition) / WeightDistanceRange);
        if (Weight <= 0.0f) continue;


        float4 NeighborRadianceSample = RadianceTexture.Load(int3(NeighborPixel,0));
        RadianceSum += NeighborRadianceSample.rgb * Weight;
        WeightSum += Weight;
    }
    OutputRadianceUAV[Pixel] = float4(RadianceSum / max(WeightSum,1.0e-5f),1.0f);
}

